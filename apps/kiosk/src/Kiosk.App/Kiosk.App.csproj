<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.7" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <!-- SumatraPDF portable .exe (3.6.1 64-bit, 19 MB). Bundled so the
         Windows print path can drive POS-80 thermal printers without
         relying on the OS PDF file-association (which Edge breaks by
         ignoring the printer argument under Start-Process -Verb Print).
         Linux/macOS builds carry the file too but never invoke it. -->
    <None Include="Assets\SumatraPDF.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Avalonia bundles AvaloniaResource items into the assembly as
         avares:// URIs. The institute logo is referenced from KioskHeader.axaml. -->
    <AvaloniaResource Include="Assets\kkmi-logo.png" />
    <!-- Robot still. Replaced the 3D scene: the GL path could not run on the
         institute's older kiosks at all (their Intel graphics cap out at
         OpenGL 3.1 and the shader needed 3.3) and hung the ones it did run
         on. Referenced from AiPage.axaml. -->
    <AvaloniaResource Include="Assets\robot-still.png" />
  </ItemGroup>
</Project>
