<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="260"
             x:Class="Kiosk.App.Controls.KioskHeader"
             x:DataType="state:SessionStore"
             Height="260">
    <!-- Header band: light gradient bottom→white, top row clock+weather,
         bottom row centred institute logo + 2-line brand title. The lang
         toggle now lives in the footer, per the 2026 redesign mockup. -->
    <Border BorderBrush="{StaticResource KioskBorder}" BorderThickness="0,0,0,1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#ffffff" />
                <GradientStop Offset="1" Color="{StaticResource KioskBgColor}" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="Auto,*" Margin="60,28,60,28">
            <!-- Top row: clock+date left, weather right -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Text="--:--"
                               FontSize="40" FontWeight="Bold"
                               Foreground="{StaticResource KioskPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DateText" Text=""
                               FontSize="20" FontWeight="Medium"
                               Foreground="{StaticResource KioskTextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center"
                            IsVisible="{Binding WeatherText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="☀"
                               FontSize="22"
                               Foreground="{StaticResource KioskAccentDark}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WeatherText}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{StaticResource KioskTextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Brand row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,16,0,0">
                <!-- Horizontal lockup (≈1.52:1), so height is pinned and the
                     width follows — a fixed square box would letterbox it. -->
                <Image Source="avares://Kiosk.App/Assets/kkmi-logo.png"
                       Height="110" Stretch="Uniform"
                       VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="780">
                    <TextBlock Text="{Binding OrgName, FallbackValue=''}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource KioskText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource HeaderTagline}"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskPrimary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
