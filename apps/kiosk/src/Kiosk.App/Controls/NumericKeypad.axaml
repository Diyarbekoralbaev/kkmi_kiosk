<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="640"
             x:Class="Kiosk.App.Controls.NumericKeypad">
    <!-- 3-column × 4-row grid, big touch targets (~150×120). Designed for the
         portrait kiosk; binds to a target TextBox via the TargetTextBox
         property and appends/erases digits there. -->
    <Border Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1"
            CornerRadius="14" Padding="12">
        <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*"
              RowSpacing="8" ColumnSpacing="8">
            <Button Grid.Row="0" Grid.Column="0" Classes="key" Content="1" Tag="1" />
            <Button Grid.Row="0" Grid.Column="1" Classes="key" Content="2" Tag="2" />
            <Button Grid.Row="0" Grid.Column="2" Classes="key" Content="3" Tag="3" />
            <Button Grid.Row="1" Grid.Column="0" Classes="key" Content="4" Tag="4" />
            <Button Grid.Row="1" Grid.Column="1" Classes="key" Content="5" Tag="5" />
            <Button Grid.Row="1" Grid.Column="2" Classes="key" Content="6" Tag="6" />
            <Button Grid.Row="2" Grid.Column="0" Classes="key" Content="7" Tag="7" />
            <Button Grid.Row="2" Grid.Column="1" Classes="key" Content="8" Tag="8" />
            <Button Grid.Row="2" Grid.Column="2" Classes="key" Content="9" Tag="9" />
            <Button Grid.Row="3" Grid.Column="0" Classes="key alt" Content="←" Tag="back" />
            <Button Grid.Row="3" Grid.Column="1" Classes="key" Content="0" Tag="0" />
            <Button Grid.Row="3" Grid.Column="2" Classes="key alt" Content="✕" Tag="clear" />
        </Grid>
    </Border>

    <UserControl.Styles>
        <Style Selector="Button.key">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="100" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Background" Value="#f1f5f9" />
            <Setter Property="Foreground" Value="#0f172a" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.key:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#cbd5e1" />
        </Style>
        <Style Selector="Button.key:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#94a3b8" />
        </Style>
        <Style Selector="Button.key.alt">
            <Setter Property="Background" Value="#e2e8f0" />
            <Setter Property="Foreground" Value="#0a4d8c" />
            <Setter Property="FontSize" Value="28" />
        </Style>
    </UserControl.Styles>
</UserControl>
