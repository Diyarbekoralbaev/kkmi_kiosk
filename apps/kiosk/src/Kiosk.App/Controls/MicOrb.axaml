<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             mc:Ignorable="d" d:DesignWidth="140" d:DesignHeight="150"
             x:Class="Kiosk.App.Controls.MicOrb"
             x:DataType="state:SessionStore"
             Width="140" Height="150"
             PointerPressed="OnPressed">
    <Grid>
        <!-- Outer pulse ring — scales with mic RMS via code-behind. -->
        <Ellipse x:Name="PulseRing" Width="120" Height="120"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,8,0,0"
                 Stroke="{StaticResource KioskPrimary}" StrokeThickness="2" Opacity="0.4" />

        <!-- Core orb -->
        <Border x:Name="Core" Width="84" Height="84"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,26,0,0"
                CornerRadius="42"
                Background="{StaticResource KioskPrimary}" BorderBrush="{StaticResource KioskPrimaryDark}" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource KioskPrimaryColor}" BlurRadius="28" Opacity="0.55" />
            </Border.Effect>
            <TextBlock Text="🎤" FontSize="32"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="White" />
        </Border>

        <!-- Status label below orb -->
        <TextBlock x:Name="StatusLabel" Text="{DynamicResource MicListening}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Foreground="{StaticResource KioskPrimaryDark}" FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,2" />
    </Grid>
</UserControl>
