<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             xmlns:controls="using:Kiosk.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1920"
             x:Class="Kiosk.App.Pages.ManualFeedbackPage"
             x:DataType="state:SessionStore">
    <!-- Touch-driven feedback flow. Visitor: type → text → phone →
         preview → submit → success. Type via three big buttons, text via
         the on-screen keyboard, phone via the numeric keypad. Mirrors
         ManualSubmitPage's multi-section pattern: one ScrollViewer per
         step, switched by ManualFeedbackStep. -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*"
          Margin="56,80,56,180">
        <!-- Page title + NavBar (back to home) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource FeedbackPageTitle}"
                       FontSize="44" FontWeight="Light"
                       Foreground="{StaticResource KioskPrimary}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="640" />
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <!-- ── 1. Type step ───────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionType"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource FeedbackTypePrompt}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <Button x:Name="TypeComplaint" Click="OnTypeComplaint"
                        Classes="typetile" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <TextBlock Text="{DynamicResource FeedbackTypeComplaint}"
                               FontSize="30" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskText}" />
                </Button>
                <Button x:Name="TypeSuggestion" Click="OnTypeSuggestion"
                        Classes="typetile" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <TextBlock Text="{DynamicResource FeedbackTypeSuggestion}"
                               FontSize="30" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskText}" />
                </Button>
                <Button x:Name="TypeGratitude" Click="OnTypeGratitude"
                        Classes="typetile" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <TextBlock Text="{DynamicResource FeedbackTypeGratitude}"
                               FontSize="30" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskText}" />
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 2. Text step ───────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionText"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource FeedbackTextTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <TextBlock Text="{DynamicResource FeedbackTextHint}"
                           FontSize="18"
                           Foreground="{StaticResource KioskTextMuted}" />
                <TextBox x:Name="TextBox"
                         Text="{Binding FeedbackText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxLength="10000"
                         MinHeight="240"
                         MaxHeight="320"
                         FontSize="22"
                         Padding="18,14"
                         Background="{StaticResource KioskCard}"
                         BorderBrush="{StaticResource KioskBorder}"
                         BorderThickness="1"
                         CornerRadius="12"
                         VerticalContentAlignment="Top" />
                <TextBlock x:Name="TextStatus"
                           Text="{DynamicResource FeedbackTextErrorShort}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <controls:OnScreenKeyboard x:Name="TextKeyboard" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnTextBack"
                            Content="{DynamicResource ManualBackButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnTextContinue"
                            Content="{DynamicResource QabulContinueButton}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 3. Phone step ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionPhone"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource FeedbackPhoneTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <TextBlock Text="{DynamicResource QabulPhoneHint}"
                           FontSize="18"
                           Foreground="{StaticResource KioskTextMuted}" />
                <TextBox x:Name="PhoneBox"
                         IsReadOnly="True"
                         FontFamily="Consolas, Menlo, Courier New, monospace"
                         FontSize="34"
                         FontWeight="SemiBold"
                         Padding="18,14"
                         Background="{StaticResource KioskCard}"
                         BorderBrush="{StaticResource KioskBorder}"
                         BorderThickness="1"
                         CornerRadius="12"
                         HorizontalContentAlignment="Center" />
                <TextBlock x:Name="PhoneStatus"
                           Text="{DynamicResource QabulConfirmErrorPhoneShort}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <controls:NumericKeypad x:Name="PhoneKeypad" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnPhoneBack"
                            Content="{DynamicResource ManualBackButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnPhoneContinue"
                            Content="{DynamicResource QabulContinueButton}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 4. Preview step ────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionPreview"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource ManualMurajatPreviewTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <Border Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}"
                        BorderThickness="1" CornerRadius="18" Padding="26">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource FeedbackTypePrompt}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewType"
                                       FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource FeedbackTextTitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewText"
                                       FontSize="22"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource FeedbackPhoneTitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewPhone"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PreviewStatus"
                           Text="{DynamicResource ManualMurajatSubmitError}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnPreviewEdit"
                            Content="{DynamicResource ManualEditButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnPreviewConfirm"
                            x:Name="SubmitButton"
                            Content="{DynamicResource ManualConfirmButton}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 5. Success ─────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionSuccess"
                      IsVisible="False">
            <Border Background="{StaticResource KioskCard}"
                    BorderBrush="{StaticResource KioskBorder}"
                    BorderThickness="1" CornerRadius="22" Padding="40"
                    HorizontalAlignment="Center" MaxWidth="720">
                <StackPanel Spacing="22" HorizontalAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="60"
                            Background="{StaticResource KioskSuccess}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="64" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource FeedbackSuccessTitle}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource KioskText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock x:Name="SuccessIdText"
                               FontSize="22"
                               FontFamily="Consolas, Menlo, Courier New, monospace"
                               Foreground="{StaticResource KioskTextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource FeedbackSuccessHint}"
                               FontSize="20"
                               Foreground="{StaticResource KioskTextMuted}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.typetile">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="32,30" />
            <Setter Property="MinHeight" Value="110" />
        </Style>
        <Style Selector="Button.typetile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#fbfcfe" />
        </Style>
    </UserControl.Styles>
</UserControl>
