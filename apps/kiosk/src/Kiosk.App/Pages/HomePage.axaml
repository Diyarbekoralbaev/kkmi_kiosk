<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1572"
             x:Class="Kiosk.App.Pages.HomePage"
             x:DataType="state:SessionStore">
    <!-- Joqarı Keńes (Supreme Council) home: 4 tiles in order —
         1. AI assistant (amber accent) → KioskPage.Ai
         2. Murajat to the Council     → KioskPage.ManualSubmit
         3. Reception registration     → KioskPage.Qabul
         4. Feedback (shaǵım/usınıs/    → KioskPage.Feedback
            minnetdarshılıq)
         No officials, no categories. Icons are ports of infokiosk.html
         SVG glyphs. -->
    <Grid Background="{StaticResource KioskBg}">
        <Grid RowDefinitions="Auto,*" Margin="60,32,60,32">
            <!-- ── Hero ─────────────────────────────────────────────── -->
            <StackPanel Grid.Row="0" Spacing="20" HorizontalAlignment="Center"
                        Margin="0,8,0,24">
                <Border Background="#e8eff7" CornerRadius="999"
                        Padding="22,10" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource HomeGreetingChip}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskPrimary}"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{DynamicResource HomeQuestion}"
                           FontSize="52" FontWeight="Bold"
                           Foreground="{StaticResource KioskText}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="900" />
                <TextBlock Text="{DynamicResource HomeSubtitle}"
                           FontSize="20"
                           Foreground="{StaticResource KioskTextMuted}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="860" />
            </StackPanel>

            <!-- ── Tiles ────────────────────────────────────────────── -->
            <StackPanel Grid.Row="1" Spacing="22" VerticalAlignment="Top">

                <!-- 1. AI Yordamchi (amber accent variant) -->
                <Button x:Name="TileAi" Click="OnTileAi" Classes="tile accent">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="118" Height="118" CornerRadius="22"
                                Background="{StaticResource KioskAccentTint}"
                                VerticalAlignment="Center">
                            <!-- Robot glyph from infokiosk.html (24x24 viewbox):
                                 rect(3,11,18,10) + circle(12,5,r=2) + line(12,7→11) + two eye dots -->
                            <Viewbox Width="72" Height="72"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="11"
                                               Width="18" Height="10"
                                               RadiusX="2" RadiusY="2"
                                               Stroke="{StaticResource KioskAccentDark}"
                                               StrokeThickness="2"
                                               Fill="Transparent" />
                                    <Ellipse Canvas.Left="10" Canvas.Top="3"
                                             Width="4" Height="4"
                                             Stroke="{StaticResource KioskAccentDark}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Line StartPoint="12,7" EndPoint="12,11"
                                          Stroke="{StaticResource KioskAccentDark}"
                                          StrokeThickness="2" StrokeLineCap="Round" />
                                    <Ellipse Canvas.Left="7" Canvas.Top="15"
                                             Width="2" Height="2"
                                             Fill="{StaticResource KioskAccentDark}" />
                                    <Ellipse Canvas.Left="15" Canvas.Top="15"
                                             Width="2" Height="2"
                                             Fill="{StaticResource KioskAccentDark}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"
                                    Margin="28,0,16,0">
                            <TextBlock Text="{DynamicResource HomeTileAiTitle}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource HomeTileAiSubtitle}"
                                       FontSize="18"
                                       Foreground="{StaticResource KioskTextMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="68" Height="68" CornerRadius="34"
                                Background="{StaticResource KioskAccentDark}"
                                VerticalAlignment="Center">
                            <TextBlock Text="›" FontSize="36" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 2. Joqarı Keńeske murajat (appeal) → ManualSubmit.
                     Document/file-text glyph from infokiosk.html. -->
                <Button x:Name="TileSubmit" Click="OnTileSubmit" Classes="tile">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="118" Height="118" CornerRadius="22"
                                Background="{StaticResource KioskTileTint}"
                                VerticalAlignment="Center">
                            <Viewbox Width="72" Height="72"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <!-- Document outline with corner fold -->
                                    <Path Stroke="{StaticResource KioskPrimary}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Fill="Transparent"
                                          Data="M14,3 H6 A2,2 0 0 0 4,5 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V9 L14,3 Z M14,3 V9 H20" />
                                    <!-- Three text lines inside -->
                                    <Line StartPoint="8,13" EndPoint="16,13"
                                          Stroke="{StaticResource KioskPrimary}"
                                          StrokeThickness="2" StrokeLineCap="Round" />
                                    <Line StartPoint="8,16" EndPoint="16,16"
                                          Stroke="{StaticResource KioskPrimary}"
                                          StrokeThickness="2" StrokeLineCap="Round" />
                                    <Line StartPoint="8,10" EndPoint="11,10"
                                          Stroke="{StaticResource KioskPrimary}"
                                          StrokeThickness="2" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"
                                    Margin="28,0,16,0">
                            <TextBlock Text="{DynamicResource HomeTileSubmitTitle}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource HomeTileSubmitSubtitle}"
                                       FontSize="18"
                                       Foreground="{StaticResource KioskTextMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="68" Height="68" CornerRadius="34"
                                Background="{StaticResource KioskPrimary}"
                                VerticalAlignment="Center">
                            <TextBlock Text="›" FontSize="36" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 3. Jeke qabılǵa jazılıw (reception registration) → Qabul.
                     Building/column glyph from infokiosk.html. -->
                <Button x:Name="TileQabul" Click="OnTileQabul" Classes="tile">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="118" Height="118" CornerRadius="22"
                                Background="{StaticResource KioskTileTint}"
                                VerticalAlignment="Center">
                            <Viewbox Width="72" Height="72"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource KioskPrimary}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Fill="Transparent"
                                          Data="M3,21 H21 M5,21 V10 L12,5 L19,10 V21 M9,21 V15 H15 V21" />
                                    <Ellipse Canvas.Left="11" Canvas.Top="7"
                                             Width="2" Height="2"
                                             Fill="{StaticResource KioskPrimary}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"
                                    Margin="28,0,16,0">
                            <TextBlock Text="{DynamicResource HomeTileQabulTitle}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource HomeTileQabulSubtitle}"
                                       FontSize="18"
                                       Foreground="{StaticResource KioskTextMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="68" Height="68" CornerRadius="34"
                                Background="{StaticResource KioskPrimary}"
                                VerticalAlignment="Center">
                            <TextBlock Text="›" FontSize="36" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 4. Shaǵım / usınıs / minnetdarshılıq (feedback) → Feedback.
                     Chat-bubble glyph. -->
                <Button x:Name="TileFeedback" Click="OnTileFeedback" Classes="tile">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="118" Height="118" CornerRadius="22"
                                Background="{StaticResource KioskTileTint}"
                                VerticalAlignment="Center">
                            <Viewbox Width="72" Height="72"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <!-- Speech-bubble outline with tail -->
                                    <Path Stroke="{StaticResource KioskPrimary}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Fill="Transparent"
                                          Data="M21,11.5 A8.38,8.38 0 0 1 12.5,19.5 A8.5,8.5 0 0 1 8,18.5 L3,20 L4.5,15 A8.5,8.5 0 0 1 3.5,11 A8.38,8.38 0 0 1 11.5,3 A8.5,8.5 0 0 1 21,11.5 Z" />
                                    <Ellipse Canvas.Left="8" Canvas.Top="10.5"
                                             Width="2" Height="2"
                                             Fill="{StaticResource KioskPrimary}" />
                                    <Ellipse Canvas.Left="14" Canvas.Top="10.5"
                                             Width="2" Height="2"
                                             Fill="{StaticResource KioskPrimary}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"
                                    Margin="28,0,16,0">
                            <TextBlock Text="{DynamicResource HomeTileFeedbackTitle}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource HomeTileFeedbackSubtitle}"
                                       FontSize="18"
                                       Foreground="{StaticResource KioskTextMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="68" Height="68" CornerRadius="34"
                                Background="{StaticResource KioskPrimary}"
                                VerticalAlignment="Center">
                            <TextBlock Text="›" FontSize="36" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="36,30" />
            <Setter Property="MinHeight" Value="178" />
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#fbfcfe" />
        </Style>
        <Style Selector="Button.tile.accent">
            <Setter Property="BorderBrush" Value="{StaticResource KioskAccent}" />
        </Style>
    </UserControl.Styles>
</UserControl>
