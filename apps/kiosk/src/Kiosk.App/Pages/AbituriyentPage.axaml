<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Kiosk.App.Controls"
             xmlns:state="using:Kiosk.App.State"
             xmlns:net="using:Kiosk.App.Net"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1224"
             x:Class="Kiosk.App.Pages.AbituriyentPage"
             x:DataType="state:SessionStore">
    <!-- Degree programmes, straight from HEMIS.
         What is deliberately NOT here: admission quotas, pass marks and tuition
         fees. HEMIS does not carry them, they change every year, and a stale or
         guessed figure is the one thing an applicant would actually act on — so
         the page points at the admissions committee instead of showing a
         number nobody can stand behind. -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*" Margin="56,40,56,32">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <TextBlock Grid.Column="0" Text="{DynamicResource AbituriyentPageTitle}"
                       FontSize="{StaticResource KioskFontH1}" FontWeight="Bold"
                       Foreground="{StaticResource KioskPrimary}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,0" RowDefinitions="Auto,*">

            <!-- Detail card — filled when the agent calls show_direction, or the
                 visitor taps a row. -->
            <Border Grid.Row="0" x:Name="DetailCard" IsVisible="False"
                    Background="{StaticResource KioskCard}"
                    BorderBrush="{StaticResource KioskAccent}" BorderThickness="2"
                    CornerRadius="{StaticResource KioskRadiusCard}"
                    Padding="32,28" Margin="0,0,0,24">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DetailName"
                               FontSize="{StaticResource KioskFontH2}" FontWeight="Bold"
                               Foreground="{StaticResource KioskText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource KioskTileTint}"
                                CornerRadius="{StaticResource KioskRadiusChip}" Padding="14,6">
                            <TextBlock x:Name="DetailType" FontSize="18"
                                       Foreground="{StaticResource KioskPrimary}" />
                        </Border>
                        <Border Background="{StaticResource KioskTileTint}"
                                CornerRadius="{StaticResource KioskRadiusChip}" Padding="14,6">
                            <TextBlock x:Name="DetailCode" FontSize="18"
                                       Foreground="{StaticResource KioskPrimary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailFaculty" FontSize="20"
                               Foreground="{StaticResource KioskTextMuted}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource AbituriyentQuotaNote}"
                               FontSize="{StaticResource KioskFontCaption}"
                               Foreground="{StaticResource KioskTextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Directions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="net:DirectionDto">
                            <Button Click="OnDirectionClick" Tag="{Binding}" Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource KioskFontH4}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource KioskText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Faculty}"
                                                   FontSize="{StaticResource KioskFontCaption}"
                                                   Foreground="{StaticResource KioskTextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource KioskTileTint}"
                                            CornerRadius="{StaticResource KioskRadiusChip}"
                                            Padding="14,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EducationType}" FontSize="16"
                                                   Foreground="{StaticResource KioskPrimary}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.row">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="26,20" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="MinHeight" Value="86" />
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#fbfcfe" />
        </Style>
    </UserControl.Styles>
</UserControl>
