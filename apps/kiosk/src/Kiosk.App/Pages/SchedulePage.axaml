<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Kiosk.App.Controls"
             xmlns:state="using:Kiosk.App.State"
             xmlns:net="using:Kiosk.App.Net"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1224"
             x:Class="Kiosk.App.Pages.SchedulePage"
             x:DataType="state:SessionStore">
    <!-- Course → group → week. Timetables are per GROUP; the kiosk identifies
         nobody, so there is no "my schedule".

         The week is the unit of navigation, not the day: the strip across the
         top carries every day's lesson count, so a free Wednesday is visible
         without tapping it, and picking a day is one touch rather than a
         calendar. The calendar stays for dates outside this week.

         Below it the day sits on a TIME RAIL — a continuous line with a
         numbered node per class, the current one marked in the kiosk's only
         warm colour. A day is a sequence in time, and the question a student
         has standing here is "which one am I at"; a list of equal rows cannot
         answer that. -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*" Margin="56,40,56,32">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{DynamicResource SchedulePageTitle}"
                           FontSize="{StaticResource KioskFontH1}" FontWeight="Bold"
                           Foreground="{StaticResource KioskInk}"
                           TextWrapping="Wrap" MaxWidth="640" />
                <TextBlock x:Name="Breadcrumb" FontSize="21"
                           Foreground="{StaticResource KioskTextMuted}"
                           TextWrapping="Wrap" MaxWidth="640" />
            </StackPanel>
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,0">

            <!-- ① Course. Bachelor only — six years of medicine, five of
                 stomatology. Residency and master's are numbered on another
                 scheme entirely and would produce nonsense courses. -->
            <ScrollViewer x:Name="CoursePanel">
                <ItemsControl x:Name="CourseList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="net:CourseDto">
                            <Button Click="OnCourseClick" Tag="{Binding}" Classes="course">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
                                    <TextBlock Grid.Column="0" Text="{Binding Course}"
                                               FontSize="72" FontWeight="Bold"
                                               Foreground="{StaticResource KioskPrimary}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource ScheduleCourseWord}"
                                                   FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource KioskInk}" />
                                        <TextBlock Text="{Binding GroupCount}"
                                                   FontSize="18"
                                                   Foreground="{StaticResource KioskTextMuted}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ② Groups on that course -->
            <Grid x:Name="GroupPanel" IsVisible="False" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="searchbox" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="24"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBox Grid.Column="1" x:Name="GroupFilter"
                                 TextChanged="OnGroupFilterChanged"
                                 PlaceholderText="{DynamicResource ScheduleFilterGroups}"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="22" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="net:GroupDto">
                                <Button Click="OnGroupClick" Tag="{Binding}" Classes="row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource KioskFontH4}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource KioskInk}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Specialty}"
                                                       FontSize="{StaticResource KioskFontCaption}"
                                                       Foreground="{StaticResource KioskTextMuted}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource KioskTileTint}"
                                                CornerRadius="{StaticResource KioskRadiusChip}"
                                                Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Language}" FontSize="16"
                                                       Foreground="{StaticResource KioskPrimary}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ③ Voice candidates — find_group returned several matches. -->
            <ScrollViewer x:Name="ChoicesPanel" IsVisible="False">
                <StackPanel Spacing="16">
                    <TextBlock Text="{DynamicResource ScheduleWhichGroup}"
                               FontSize="{StaticResource KioskFontH3}" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskInk}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding GroupChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="net:GroupDto">
                                <Button Click="OnGroupClick" Tag="{Binding}" Classes="row">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource KioskFontH4}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource KioskInk}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Specialty}"
                                                   FontSize="{StaticResource KioskFontCaption}"
                                                   Foreground="{StaticResource KioskTextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ④ The week -->
            <Grid x:Name="LessonPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto">

                <!-- Week strip: navigation and date picker in one. -->
                <Border Grid.Row="0" Classes="strip" Margin="0,0,0,18">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" Click="OnPrevWeek" Classes="step"
                                    Content="‹" />
                            <TextBlock Grid.Column="1" Text="{Binding ScheduleRangeLabel}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Click="OnNextWeek" Classes="step"
                                    Content="›" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="state:WeekDayCell">
                                    <Button Click="OnDayClick" Tag="{Binding}" Classes="day"
                                            Classes.selected="{Binding IsSelected}"
                                            Classes.today="{Binding IsToday}"
                                            Classes.empty="{Binding !HasLessons}">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ShortName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding DayNumber}"
                                                       FontSize="26" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Count}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       IsVisible="{Binding HasLessons}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12"
                            Margin="0,0,0,18">
                    <Button Click="OnToday" Classes="step wide"
                            Content="{DynamicResource ScheduleScopeToday}" />
                    <Button Click="OnPickDate" Classes="step wide"
                            Content="{DynamicResource ScheduleScopeDate}" />
                </StackPanel>

                <!-- The day, on its rail. -->
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding LessonDays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="state:LessonDay">
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                Margin="4,0,0,14">
                                        <TextBlock Text="{Binding DateLabel}"
                                                   FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource KioskInk}" />
                                        <TextBlock Text="{Binding DayName}"
                                                   FontSize="26"
                                                   Foreground="{StaticResource KioskTextMuted}" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="state:LessonRow">
                                                <Grid ColumnDefinitions="58,*" MinHeight="104">
                                                    <!-- Rail: the line runs the
                                                         full row height, so
                                                         consecutive rows join
                                                         into one continuous
                                                         spine. -->
                                                    <Grid Grid.Column="0">
                                                        <Border Width="2" HorizontalAlignment="Center"
                                                                Background="{StaticResource KioskBorder}" />
                                                        <Border Width="40" Height="40" CornerRadius="20"
                                                                VerticalAlignment="Top"
                                                                HorizontalAlignment="Center"
                                                                Classes="node"
                                                                Classes.now="{Binding IsNow}"
                                                                Classes.past="{Binding IsPast}">
                                                            <TextBlock Text="{Binding Index}"
                                                                       FontSize="17" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>

                                                    <Border Grid.Column="1" Classes="lesson"
                                                            Classes.now="{Binding IsNow}"
                                                            Classes.past="{Binding IsPast}">
                                                        <Grid ColumnDefinitions="94,*,Auto"
                                                              ColumnSpacing="18">
                                                            <StackPanel Grid.Column="0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Lesson.Start}"
                                                                           FontSize="27" FontWeight="Bold"
                                                                           Foreground="{StaticResource KioskInk}" />
                                                                <TextBlock Text="{Binding Lesson.End}"
                                                                           FontSize="17"
                                                                           Foreground="{StaticResource KioskTextMuted}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="5"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Lesson.Subject}"
                                                                           FontSize="23" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource KioskInk}"
                                                                           TextWrapping="Wrap" />
                                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                                    <TextBlock Text="{Binding Lesson.Teacher}"
                                                                               FontSize="16"
                                                                               Foreground="{StaticResource KioskTextMuted}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Lesson.Kind}"
                                                                               FontSize="15"
                                                                               Foreground="{StaticResource KioskTextMuted}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Classes="room"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Lesson.Room}"
                                                                           FontSize="20" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state. Three reasons need three sentences: a free
                     day, a group HEMIS has no timetable for at all, and the
                     summer gap before next year loads. -->
                <Border Grid.Row="2" x:Name="EmptyState" IsVisible="False"
                        Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource KioskRadiusCard}"
                        Padding="48" VerticalAlignment="Top">
                    <StackPanel Spacing="18" HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyTitle"
                                   FontSize="{StaticResource KioskFontH3}" FontWeight="SemiBold"
                                   Foreground="{StaticResource KioskInk}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
                        <TextBlock x:Name="EmptyBody" FontSize="20"
                                   Foreground="{StaticResource KioskTextMuted}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="3" Click="OnBackToGroups" Classes="step wide"
                        HorizontalAlignment="Left" Margin="0,18,0,0"
                        Content="{DynamicResource ScheduleChangeGroup}" />
            </Grid>

            <!-- Date picker. An inline Calendar, not a dropdown: on a portrait
                 touch screen the dropdown's cells are far too small to hit. -->
            <Border x:Name="DatePickerOverlay" IsVisible="False" Background="#cc0b1b3a">
                <Border Background="{StaticResource KioskCard}"
                        CornerRadius="{StaticResource KioskRadiusCard}"
                        Padding="36,32" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="640">
                    <StackPanel Spacing="22">
                        <TextBlock Text="{DynamicResource ScheduleChooseDate}"
                                   FontSize="{StaticResource KioskFontH3}" FontWeight="Bold"
                                   Foreground="{StaticResource KioskInk}" TextWrapping="Wrap" />
                        <Calendar x:Name="DayCalendar" SelectionMode="SingleDate" />
                        <StackPanel Orientation="Horizontal" Spacing="14"
                                    HorizontalAlignment="Right">
                            <Button Click="OnCancelDate" Classes="step wide"
                                    Content="{DynamicResource CommonCancel}" />
                            <Button Click="OnConfirmDate" Classes="step wide primary"
                                    Content="{DynamicResource ScheduleShowDay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <!-- Course cards: two per row, the numeral doing the work. -->
        <Style Selector="Button.course">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusCard}" />
            <Setter Property="Width" Value="464" />
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Padding" Value="34,26" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.course:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KioskTileTint}" />
        </Style>

        <Style Selector="Button.row">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="26,20" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="MinHeight" Value="86" />
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#fbfcfe" />
        </Style>

        <Style Selector="Border.strip">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusCard}" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <!-- Week-strip day. Selected wins over today: the visitor's own choice
             must be unambiguous, and today keeps its warm text either way. -->
        <Style Selector="Button.day">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KioskInk}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="6,12" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.day.empty">
            <Setter Property="Foreground" Value="{StaticResource KioskBorder}" />
        </Style>
        <Style Selector="Button.day.today">
            <Setter Property="Foreground" Value="{StaticResource KioskNow}" />
        </Style>
        <Style Selector="Button.day.selected">
            <Setter Property="Background" Value="{StaticResource KioskInk}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.day.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KioskInk}" />
        </Style>

        <!-- Rail node -->
        <Style Selector="Border.node">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.node > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource KioskTextMuted}" />
        </Style>
        <Style Selector="Border.node.now">
            <Setter Property="Background" Value="{StaticResource KioskNow}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskNow}" />
        </Style>
        <Style Selector="Border.node.now > TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.lesson">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="Padding" Value="22,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="Border.lesson.now">
            <Setter Property="Background" Value="{StaticResource KioskNowTint}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskNow}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.lesson.past">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="Border.room">
            <Setter Property="Background" Value="{StaticResource KioskTileTint}" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusChip}" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
        <Style Selector="Border.room > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource KioskPrimary}" />
        </Style>

        <Style Selector="Button.step">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="Foreground" Value="{StaticResource KioskInk}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.step.wide">
            <Setter Property="Padding" Value="26,14" />
            <Setter Property="FontSize" Value="19" />
        </Style>
        <Style Selector="Button.step.primary">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.searchbox">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="Padding" Value="24,14" />
        </Style>

        <Style Selector="Calendar">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Calendar CalendarDayButton">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="Calendar CalendarButton">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>
</UserControl>
