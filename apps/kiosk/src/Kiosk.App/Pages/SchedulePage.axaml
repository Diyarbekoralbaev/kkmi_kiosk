<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Kiosk.App.Controls"
             xmlns:state="using:Kiosk.App.State"
             xmlns:net="using:Kiosk.App.Net"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1224"
             x:Class="Kiosk.App.Pages.SchedulePage"
             x:DataType="state:SessionStore">
    <!-- Timetables are per GROUP. The kiosk identifies nobody, so there is no
         "my schedule" — the visitor either taps faculty → group, or says the
         group name and the agent confirms the match before anything renders.
         Both paths land on the same lesson list below.

         Only one of the four panels is visible at a time; the code-behind owns
         which. Voice can jump straight to Lessons by pushing show_schedule.

         Lessons render as DAYS, not as one flat list: a week is ~35 rows and
         without headers there is no way to see where Tuesday ends. -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*" Margin="56,40,56,32">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{DynamicResource SchedulePageTitle}"
                           FontSize="{StaticResource KioskFontH1}" FontWeight="Bold"
                           Foreground="{StaticResource KioskPrimary}"
                           TextWrapping="Wrap" MaxWidth="640" />
                <TextBlock x:Name="Breadcrumb" FontSize="20"
                           Foreground="{StaticResource KioskTextMuted}"
                           TextWrapping="Wrap" MaxWidth="640" />
            </StackPanel>
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,0">

            <!-- ① Faculty picker -->
            <ScrollViewer x:Name="FacultyPanel">
                <ItemsControl x:Name="FacultyList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="net:FacultyDto">
                            <Button Click="OnFacultyClick" Tag="{Binding}" Classes="row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="{StaticResource KioskFontH4}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource KioskText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="›" FontSize="34" FontWeight="Bold"
                                               Foreground="{StaticResource KioskPrimary}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ② Group picker. ~1000 groups across 4 faculties, so this scrolls. -->
            <Grid x:Name="GroupPanel" IsVisible="False" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="searchbox" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="24"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBox Grid.Column="1" x:Name="GroupFilter"
                                 TextChanged="OnGroupFilterChanged"
                                 PlaceholderText="{DynamicResource ScheduleFilterGroups}"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="22" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="net:GroupDto">
                                <Button Click="OnGroupClick" Tag="{Binding}" Classes="row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource KioskFontH4}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource KioskText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Specialty}"
                                                       FontSize="{StaticResource KioskFontCaption}"
                                                       Foreground="{StaticResource KioskTextMuted}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource KioskTileTint}"
                                                CornerRadius="{StaticResource KioskRadiusChip}"
                                                Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Language}" FontSize="16"
                                                       Foreground="{StaticResource KioskPrimary}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ③ Voice candidates — shown when find_group returned more than
                 one plausible match and the visitor should pick. -->
            <ScrollViewer x:Name="ChoicesPanel" IsVisible="False">
                <StackPanel Spacing="16">
                    <TextBlock Text="{DynamicResource ScheduleWhichGroup}"
                               FontSize="{StaticResource KioskFontH3}" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding GroupChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="net:GroupDto">
                                <Button Click="OnGroupClick" Tag="{Binding}" Classes="row">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource KioskFontH4}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource KioskText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Specialty}"
                                                   FontSize="{StaticResource KioskFontCaption}"
                                                   Foreground="{StaticResource KioskTextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ④ Lessons -->
            <Grid x:Name="LessonPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto">

                <!-- Which span is on screen. Load defaults to the group's last
                     taught week, so without this line a visitor would read a
                     May timetable believing it was this week's. -->
                <Border Grid.Row="0" Classes="rangebar" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ScheduleRangeLabel}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource KioskPrimary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" x:Name="RangeNote" FontSize="17"
                                   Foreground="{StaticResource KioskTextMuted}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Scope chips + date picker -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                    <Button x:Name="ScopeLast" Click="OnScopeLast" Classes="scope"
                            Content="{DynamicResource ScheduleScopeLastWeek}" />
                    <Button x:Name="ScopeToday" Click="OnScopeToday" Classes="scope"
                            Content="{DynamicResource ScheduleScopeToday}" />
                    <Button x:Name="ScopeTomorrow" Click="OnScopeTomorrow" Classes="scope"
                            Content="{DynamicResource ScheduleScopeTomorrow}" />
                    <Button x:Name="ScopeDate" Click="OnPickDate" Classes="scope"
                            Content="{DynamicResource ScheduleScopeDate}" />
                </StackPanel>

                <!-- Days. Each header carries weekday + date + lesson count; the
                     current day is tinted so it is findable at a glance. -->
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding LessonDays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="state:LessonDay">
                                <StackPanel Margin="0,0,0,26">
                                    <Border Classes="dayheader"
                                            Classes.today="{Binding IsToday}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <TextBlock Grid.Column="0" Text="{Binding DayName}"
                                                       FontSize="24" FontWeight="Bold"
                                                       Foreground="{StaticResource KioskPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DateLabel}"
                                                       FontSize="22"
                                                       Foreground="{StaticResource KioskTextMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Lessons.Count}"
                                                       FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{StaticResource KioskAccentDark}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Lessons}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="net:LessonDto">
                                                <Border Classes="lesson">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                                          ColumnSpacing="18">
                                                        <!-- Time first: it is what a student scans
                                                             for, and fixed width keeps the column
                                                             aligned all the way down. -->
                                                        <StackPanel Grid.Column="0" Width="86"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Start}"
                                                                       FontSize="26" FontWeight="Bold"
                                                                       Foreground="{StaticResource KioskText}" />
                                                            <TextBlock Text="{Binding End}"
                                                                       FontSize="16"
                                                                       Foreground="{StaticResource KioskTextMuted}" />
                                                        </StackPanel>
                                                        <!-- Accent rule ties the row to its time
                                                             column without drawing a full border. -->
                                                        <Border Grid.Column="1" Width="4"
                                                                CornerRadius="2"
                                                                Background="{StaticResource KioskAccent}" />
                                                        <StackPanel Grid.Column="2" Spacing="5"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Subject}"
                                                                       FontSize="{StaticResource KioskFontH4}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource KioskText}"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBlock Text="{Binding Teacher}"
                                                                           FontSize="{StaticResource KioskFontCaption}"
                                                                           Foreground="{StaticResource KioskTextMuted}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Kind}"
                                                                           FontSize="{StaticResource KioskFontCaptionSm}"
                                                                           Foreground="{StaticResource KioskTextMuted}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="3"
                                                                Background="{StaticResource KioskAccentTint}"
                                                                CornerRadius="{StaticResource KioskRadiusChip}"
                                                                Padding="16,8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Room}" FontSize="19"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource KioskAccentDark}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state. "Free day" and "the year isn't published yet"
                     look identical but mean opposite things — over the summer
                     the second is normal and must not read as a broken kiosk,
                     so it gets its own message plus a way to still see data. -->
                <Border Grid.Row="2" x:Name="EmptyState" IsVisible="False"
                        Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource KioskRadiusCard}"
                        Padding="48" VerticalAlignment="Top">
                    <StackPanel Spacing="20" HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyTitle"
                                   FontSize="{StaticResource KioskFontH3}" FontWeight="SemiBold"
                                   Foreground="{StaticResource KioskText}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />
                        <TextBlock x:Name="EmptyBody"
                                   FontSize="20"
                                   Foreground="{StaticResource KioskTextMuted}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />
                        <Button x:Name="LastYearButton" Click="OnScopeLast"
                                IsVisible="False" Classes="scope primary"
                                HorizontalAlignment="Center"
                                Content="{DynamicResource ScheduleShowLastYear}" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="3" Click="OnBackToGroups" Classes="scope"
                        HorizontalAlignment="Left" Margin="0,20,0,0"
                        Content="{DynamicResource ScheduleChangeGroup}" />
            </Grid>

            <!-- Date picker overlay. An inline Calendar rather than a
                 CalendarDatePicker dropdown: on a 1080-wide portrait touch
                 screen the dropdown's cells are far too small to hit, and the
                 popup would clip at the panel edge. -->
            <Border x:Name="DatePickerOverlay" IsVisible="False"
                    Background="#cc0f2154">
                <Border Background="{StaticResource KioskCard}"
                        CornerRadius="{StaticResource KioskRadiusCard}"
                        Padding="36,32" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="640">
                    <StackPanel Spacing="22">
                        <TextBlock Text="{DynamicResource ScheduleChooseDate}"
                                   FontSize="{StaticResource KioskFontH3}" FontWeight="Bold"
                                   Foreground="{StaticResource KioskPrimary}"
                                   TextWrapping="Wrap" />
                        <Calendar x:Name="DayCalendar"
                                  SelectionMode="SingleDate"
                                  SelectedDatesChanged="OnCalendarDateChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="14"
                                    HorizontalAlignment="Right">
                            <Button Click="OnCancelDate" Classes="scope"
                                    Content="{DynamicResource CommonCancel}" />
                            <Button Click="OnConfirmDateWeek" Classes="scope"
                                    Content="{DynamicResource ScheduleWholeWeek}" />
                            <Button Click="OnConfirmDate" Classes="scope primary"
                                    Content="{DynamicResource ScheduleShowDay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.row">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="26,20" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="MinHeight" Value="86" />
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#fbfcfe" />
        </Style>

        <Style Selector="Border.searchbox">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="Padding" Value="24,14" />
        </Style>

        <Style Selector="Border.rangebar">
            <Setter Property="Background" Value="{StaticResource KioskTileTint}" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="Padding" Value="24,14" />
        </Style>

        <Style Selector="Border.dayheader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="4,0,4,10" />
        </Style>
        <Style Selector="Border.dayheader.today">
            <Setter Property="Background" Value="{StaticResource KioskAccentTint}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusChip}" />
            <Setter Property="Padding" Value="16,10" />
        </Style>

        <Style Selector="Border.lesson">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="Padding" Value="22,16" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="Button.scope">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="Foreground" Value="{StaticResource KioskText}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource KioskRadiusButton}" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="MinHeight" Value="60" />
        </Style>
        <Style Selector="Button.scope.primary">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.scope.active">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.scope.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
        </Style>

        <!-- The stock Calendar is sized for a mouse. Scale the cells up so a
             finger can hit a single day. -->
        <Style Selector="Calendar">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Calendar CalendarDayButton">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="Calendar CalendarButton">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>
</UserControl>
