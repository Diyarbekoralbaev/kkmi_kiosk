<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             xmlns:controls="using:Kiosk.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1920"
             x:Class="Kiosk.App.Pages.SubmitPage"
             x:DataType="state:SessionStore">
    <!-- AI voice murajat preview. The agent composes a draft (text + phone,
         plus name for a new citizen) and pushes it over the WS — this page is
         a passive read-only preview; submission is driven by voice. -->
    <Grid Background="#f4f7fb" RowDefinitions="Auto,*" Margin="56,80,56,180">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <TextBlock Grid.Column="0" Text="{DynamicResource SubmitPageTitle}"
                       FontSize="44" FontWeight="Light" Foreground="#0a4d8c"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="640" />
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <!-- Live preview / transcript -->
        <ScrollViewer Grid.Row="1" Margin="0,32,0,0">
            <StackPanel Spacing="16">
                <Border IsVisible="{Binding LiveTranscript, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1"
                        CornerRadius="14" Padding="26,18">
                    <TextBlock Text="{Binding LiveTranscript}" Foreground="#0f172a"
                               FontSize="26" TextWrapping="Wrap" />
                </Border>

                <!-- Citizen name — only present for a new / «men emas» citizen -->
                <Border IsVisible="{Binding SubmitFirstName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1"
                        CornerRadius="14" Padding="26,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource SubmitNameLabel}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#0a4d8c" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding SubmitFirstName}" FontSize="26"
                                       FontWeight="SemiBold" Foreground="#0f172a" />
                            <TextBlock Text="{Binding SubmitLastName}" FontSize="26"
                                       FontWeight="SemiBold" Foreground="#0f172a" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding SubmitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1"
                        CornerRadius="14" Padding="26,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource SubmitTextLabel}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#0a4d8c" />
                        <TextBlock Text="{Binding SubmitText}" FontSize="26"
                                   Foreground="#0f172a" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding SubmitPhone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1"
                        CornerRadius="14" Padding="26,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource SubmitPhoneLabel}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#0a4d8c" />
                        <TextBlock Text="{Binding SubmitPhone}" FontSize="28"
                                   FontWeight="SemiBold" Foreground="#0f172a" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
