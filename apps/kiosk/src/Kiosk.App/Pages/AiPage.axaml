<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:robot="using:Kiosk.App.Robot"
             xmlns:controls="using:Kiosk.App.Controls"
             xmlns:state="using:Kiosk.App.State"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1572"
             x:Class="Kiosk.App.Pages.AiPage"
             x:DataType="state:SessionStore">
    <!-- 2026 redesign: dedicated AI assistant page. Robot fills the body and
         is audio-reactive via Robot.Analyser (wired in OnLoaded). MicOrb is
         hidden by MainWindow while this page is active — the robot itself
         is the listening indicator. Voice session auto-starts on Loaded
         and auto-closes when the user navigates Home (back button or 30s
         silence timer). Navigation to Submit/Qabul from here keeps the
         session alive so the agent can complete murojaat/qabul flows. -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*,Auto"
          Margin="{DynamicResource KioskContentMargin}"
          MaxWidth="{DynamicResource KioskTextMaxW}" HorizontalAlignment="Center">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <TextBlock Grid.Column="0" Text="{DynamicResource AiPageTitle}"
                       FontSize="44" FontWeight="Bold"
                       Foreground="{StaticResource KioskAccentDark}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="640" />
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <!-- Robot card. Background card-white so the OpenGL surface has a
             clean frame; the OpenGL viewport clears to its own dark color. -->
        <Border Grid.Row="1" Margin="0,28,0,28" CornerRadius="32"
                Background="{StaticResource KioskCard}"
                BorderBrush="{StaticResource KioskBorder}" BorderThickness="1"
                ClipToBounds="True">
            <robot:RobotControl x:Name="Robot" />
        </Border>

        <StackPanel Grid.Row="2" Spacing="14" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Border Background="{StaticResource KioskAccentTint}" CornerRadius="999"
                    Padding="28,12" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="{DynamicResource AiPageStatusConnecting}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskAccentDark}"
                           HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="{DynamicResource AiPageHint}"
                       FontSize="20"
                       Foreground="{StaticResource KioskTextMuted}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="820" />
        </StackPanel>
    </Grid>
</UserControl>
