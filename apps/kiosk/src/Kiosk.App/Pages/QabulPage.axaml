<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             xmlns:controls="using:Kiosk.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1920"
             x:Class="Kiosk.App.Pages.QabulPage"
             x:DataType="state:SessionStore">
    <!-- Joqarı Keńes reception registration. No officials, no scheduled
         date. Flow:
           A. (optional) topic via on-screen keyboard — skippable.
           B. phone via numeric keypad.
           B2. phone confirm (catch typos before submit).
           B3. voice-flow preview (topic + phone) when the AI agent calls
               preview_appointment.
           C. success talon: org name, reference_no, topic, masked phone,
              QR, and "Council will call you back". -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*" Margin="56,80,56,180">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <TextBlock Grid.Column="0" x:Name="QabulTitleText"
                       Text="{DynamicResource QabulPageTitle}"
                       FontSize="40" FontWeight="Bold"
                       Foreground="{StaticResource KioskPrimary}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="640" />
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,0">
            <!-- A. (Optional) topic — issue summary the Council will see. -->
            <ScrollViewer x:Name="SectionEnterTopic" IsVisible="False">
                <StackPanel Spacing="18">
                    <TextBlock Text="{DynamicResource QabulRegisterIntro}"
                               FontSize="22"
                               Foreground="{StaticResource KioskTextMuted}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource QabulTopicLabel}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskText}" />
                    <TextBlock Text="{DynamicResource QabulTopicHint}"
                               FontSize="16"
                               Foreground="{StaticResource KioskTextMuted}" />
                    <TextBox x:Name="TopicBox"
                             Text="{Binding AppointmentTopic, Mode=TwoWay}"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MaxLength="500"
                             MinHeight="120"
                             FontSize="26"
                             Padding="18,14"
                             Background="{StaticResource KioskCard}"
                             BorderBrush="{StaticResource KioskBorder}"
                             BorderThickness="1"
                             CornerRadius="12" />

                    <!-- Custom on-screen keyboard. TargetTextBox wired in
                         QabulPage.axaml.cs Loaded handler. -->
                    <controls:OnScreenKeyboard x:Name="TopicKeyboard" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <!-- Topic is optional — visitor may skip straight to phone. -->
                        <Button Grid.Column="0" Click="OnTopicSkip"
                                Content="{DynamicResource QabulTopicSkip}"
                                Background="{StaticResource KioskTileTint}"
                                Foreground="{StaticResource KioskPrimary}"
                                FontSize="20" FontWeight="SemiBold"
                                Padding="24,16" CornerRadius="14" />
                        <Button Grid.Column="1" Click="OnTopicContinue"
                                Content="{DynamicResource QabulContinueButton}"
                                Background="{StaticResource KioskPrimary}"
                                Foreground="White"
                                FontSize="22" FontWeight="SemiBold"
                                Padding="28,18" CornerRadius="14"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- B. Enter phone (keypad) -->
            <ScrollViewer x:Name="SectionEnterPhone" IsVisible="False">
                <StackPanel Spacing="16">
                    <TextBlock Text="{DynamicResource QabulRegisterIntro}"
                               FontSize="22"
                               Foreground="{StaticResource KioskTextMuted}"
                               TextWrapping="Wrap" />
                    <Button Click="OnEditTopic" Classes="ghost" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="←" FontSize="18" />
                            <TextBlock Text="{DynamicResource QabulEditTopic}" FontSize="15" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{DynamicResource QabulPhoneLabel}"
                               FontSize="16" Foreground="{StaticResource KioskPrimary}"
                               Margin="0,12,0,0" />
                    <TextBox x:Name="PhoneBox"
                             FontSize="34" IsReadOnly="True"
                             FontFamily="Consolas, Menlo, Courier New, monospace"
                             Background="{StaticResource KioskCard}"
                             Foreground="{StaticResource KioskText}"
                             BorderBrush="{StaticResource KioskBorder}" BorderThickness="1"
                             CornerRadius="10" Padding="18,16" />
                    <controls:NumericKeypad x:Name="Keypad" />

                    <TextBlock x:Name="ConfirmStatus"
                               Foreground="{StaticResource KioskError}" FontSize="14"
                               IsVisible="False" TextWrapping="Wrap" />

                    <Button x:Name="PreviewButton" Click="OnGoToPhonePreview"
                            Classes="primary" HorizontalAlignment="Stretch">
                        <TextBlock Text="{DynamicResource QabulConfirmButton}"
                                   FontSize="22" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- B2. Phone preview — confirm before submit. Catches typos
                 before the registration gets committed to the DB and the
                 talon prints with the wrong number. -->
            <ScrollViewer x:Name="SectionPhonePreview" IsVisible="False">
                <StackPanel Spacing="22" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource QabulPhonePreviewTitle}"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource QabulPhonePreviewHint}"
                               FontSize="18"
                               Foreground="{StaticResource KioskTextMuted}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="720" />
                    <Border Background="{StaticResource KioskCard}"
                            BorderBrush="{StaticResource KioskPrimary}" BorderThickness="2"
                            CornerRadius="20" Padding="36,28"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="PhonePreviewText"
                                   FontSize="48" FontWeight="Bold"
                                   FontFamily="Consolas, Menlo, Courier New, monospace"
                                   Foreground="{StaticResource KioskPrimary}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="PhonePreviewStatus"
                               Foreground="{StaticResource KioskError}" FontSize="14"
                               IsVisible="False" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,12,0,0">
                        <Button Grid.Column="0" Click="OnPhoneEdit" Classes="ghost"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="{DynamicResource QabulPhonePreviewEdit}"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="1" x:Name="ConfirmButton"
                                Click="OnConfirmClicked" Classes="primary"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="{DynamicResource QabulPhonePreviewSend}"
                                       FontSize="20" FontWeight="SemiBold" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- B3. Voice-flow preview — shown after the AI agent calls
                 `preview_appointment`. Lets the visitor verify the captured
                 fields (topic + masked phone) BEFORE the AI submits.
                 Buttons forward to the backend as user_text envelopes. -->
            <ScrollViewer x:Name="SectionVoicePreview" IsVisible="False">
                <StackPanel Spacing="22" VerticalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="{DynamicResource QabulVoicePreviewTitle}"
                               FontSize="32" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <Border Background="{StaticResource KioskCard}"
                            BorderBrush="{StaticResource KioskPrimary}" BorderThickness="2"
                            CornerRadius="20" Padding="36,28"
                            MaxWidth="720" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="20" RowSpacing="14">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource QabulVoicePreviewTopicLabel}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskTextMuted}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       x:Name="VoicePreviewTopic"
                                       FontSize="18"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource QabulVoicePreviewPhoneLabel}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       x:Name="VoicePreviewPhone"
                                       FontSize="20" FontWeight="SemiBold"
                                       FontFamily="Consolas, Menlo, Courier New, monospace"
                                       Foreground="{StaticResource KioskPrimary}" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,12,0,0"
                          MaxWidth="720" HorizontalAlignment="Center">
                        <Button Grid.Column="0" Click="OnVoicePreviewReject" Classes="ghost"
                                HorizontalAlignment="Stretch" MinHeight="68">
                            <TextBlock Text="{DynamicResource QabulVoicePreviewReject}"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Button>
                        <Button Grid.Column="1" Click="OnVoicePreviewConfirm" Classes="primary"
                                HorizontalAlignment="Stretch" MinHeight="68">
                            <TextBlock Text="{DynamicResource QabulVoicePreviewConfirm}"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- C. Success — on-screen talon. No official, no date, no queue:
                 org name, reference_no, topic (if any), masked phone, QR, and
                 the "Council will call you back" line. -->
            <ScrollViewer x:Name="SectionSuccess" IsVisible="False">
                <Border Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}" BorderThickness="1"
                        CornerRadius="20" Padding="44,36"
                        MaxWidth="780" HorizontalAlignment="Center">
                    <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="TalonOrgName"
                                   Text="{Binding OrgName}"
                                   FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource KioskText}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource QabulTalonSubtitle}"
                                   FontSize="22"
                                   Foreground="{StaticResource KioskText}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,8,0,18" />

                        <Path Stroke="{StaticResource KioskBorder}" StrokeThickness="1"
                              StrokeDashArray="3,3" Data="M0,0 L1,0"
                              Stretch="Fill" Height="1" Margin="0,0,0,16" />

                        <!-- Reference number (bold label + value run). Labels
                             are named so code-behind can refresh them from
                             LocalizationService on language change. -->
                        <TextBlock FontSize="22" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{StaticResource KioskText}">
                            <Run x:Name="TalonLabelReference" FontWeight="Bold" />
                            <Run Text="{Binding AppointmentReferenceNo}" />
                        </TextBlock>
                        <TextBlock FontSize="22" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{StaticResource KioskText}"
                                   IsVisible="{Binding AppointmentTopic,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Run x:Name="TalonLabelMasala" FontWeight="Bold" />
                            <Run Text="{Binding AppointmentTopic}" />
                        </TextBlock>

                        <Path Stroke="{StaticResource KioskBorder}" StrokeThickness="1"
                              StrokeDashArray="3,3" Data="M0,0 L1,0"
                              Stretch="Fill" Height="1" Margin="0,8,0,16" />

                        <TextBlock FontSize="22" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{StaticResource KioskText}">
                            <Run x:Name="TalonLabelTelefon" FontWeight="Bold" />
                            <Run Text="{Binding AppointmentPhoneMasked}" />
                        </TextBlock>

                        <Path Stroke="{StaticResource KioskBorder}" StrokeThickness="1"
                              StrokeDashArray="3,3" Data="M0,0 L1,0"
                              Stretch="Fill" Height="1" Margin="0,8,0,16" />

                        <Image x:Name="QrImage" Width="280" Height="280"
                               HorizontalAlignment="Center" Margin="0,8,0,16" />

                        <!-- "Council will call you back" -->
                        <TextBlock Text="{DynamicResource QabulTalonCallback}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource KioskPrimary}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock x:Name="TalonFooter"
                                   Text="{DynamicResource QabulTalonScanHint}"
                                   FontSize="18"
                                   Foreground="{StaticResource KioskTextMuted}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KioskPrimaryDark}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KioskTextMuted}" />
            <Setter Property="Padding" Value="14,16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>
</UserControl>
