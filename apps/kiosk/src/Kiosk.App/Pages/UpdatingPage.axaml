<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:state="using:Kiosk.App.State"
             x:Class="Kiosk.App.Pages.UpdatingPage"
             x:DataType="state:SessionStore">
    <Grid Background="{StaticResource KioskBg}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32" MaxWidth="640">
            <TextBlock Text="{DynamicResource UpdatingTitle}"
                       FontSize="48" FontWeight="Light" Foreground="{StaticResource KioskPrimary}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource UpdatingBody}"
                       FontSize="18" Foreground="#64748b"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" />

            <Border Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1"
                    CornerRadius="999" Padding="2" Width="520" Height="20">
                <Grid>
                    <Border x:Name="ProgressFill"
                            Background="{StaticResource KioskPrimary}"
                            CornerRadius="999"
                            HorizontalAlignment="Left"
                            Width="0" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusLine"
                       Text="{DynamicResource UpdatingStatusPreparing}"
                       FontSize="14" Foreground="{StaticResource KioskPrimary}"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="VersionLine"
                       FontSize="13" Foreground="#94a3b8" FontFamily="monospace"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
