<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             xmlns:controls="using:Kiosk.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1920"
             x:Class="Kiosk.App.Pages.ManualSubmitPage"
             x:DataType="state:SessionStore">
    <!-- Touch-driven murajaat flow. Visitor: topic → body → phone →
         preview → submit → success. All text via the on-screen
         keyboard, phone via the numeric keypad. Mirrors QabulPage's
         multi-section pattern: one ScrollViewer per step, switched
         by ManualSubmitStep. -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*"
          Margin="56,80,56,180">
        <!-- Page title + NavBar (back to home) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource ManualSubmitPageTitle}"
                       FontSize="44" FontWeight="Light"
                       Foreground="{StaticResource KioskPrimary}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="640" />
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <!-- ── 1. Topic step ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionTopic"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource ManualMurajatTopicTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <TextBlock Text="{DynamicResource ManualMurajatTopicHint}"
                           FontSize="18"
                           Foreground="{StaticResource KioskTextMuted}" />
                <TextBox x:Name="TopicBox"
                         Text="{Binding SubmitTopic, Mode=TwoWay}"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         MaxLength="500"
                         MinHeight="120"
                         FontSize="26"
                         Padding="18,14"
                         Background="{StaticResource KioskCard}"
                         BorderBrush="{StaticResource KioskBorder}"
                         BorderThickness="1"
                         CornerRadius="12" />
                <TextBlock x:Name="TopicStatus"
                           Text="{DynamicResource QabulTopicErrorShort}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <controls:OnScreenKeyboard x:Name="TopicKeyboard" />
                <Button Click="OnTopicContinue"
                        Content="{DynamicResource QabulContinueButton}"
                        Background="{StaticResource KioskPrimary}"
                        Foreground="White"
                        FontSize="22" FontWeight="SemiBold"
                        Padding="28,18" CornerRadius="14"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── 2. Body step ───────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionBody"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource ManualMurajatBodyTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <TextBlock Text="{DynamicResource ManualMurajatBodyHint}"
                           FontSize="18"
                           Foreground="{StaticResource KioskTextMuted}" />
                <TextBox x:Name="BodyBox"
                         Text="{Binding SubmitBody, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxLength="10000"
                         MinHeight="240"
                         MaxHeight="320"
                         FontSize="22"
                         Padding="18,14"
                         Background="{StaticResource KioskCard}"
                         BorderBrush="{StaticResource KioskBorder}"
                         BorderThickness="1"
                         CornerRadius="12"
                         VerticalContentAlignment="Top" />
                <TextBlock x:Name="BodyStatus"
                           Text="{DynamicResource ManualMurajatBodyErrorShort}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <controls:OnScreenKeyboard x:Name="BodyKeyboard" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnBodyBack"
                            Content="{DynamicResource ManualBackButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnBodyContinue"
                            Content="{DynamicResource QabulContinueButton}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 3. Phone step ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionPhone"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource ManualMurajatPhoneTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <TextBlock Text="{DynamicResource QabulPhoneHint}"
                           FontSize="18"
                           Foreground="{StaticResource KioskTextMuted}" />
                <TextBox x:Name="PhoneBox"
                         IsReadOnly="True"
                         FontFamily="Consolas, Menlo, Courier New, monospace"
                         FontSize="34"
                         FontWeight="SemiBold"
                         Padding="18,14"
                         Background="{StaticResource KioskCard}"
                         BorderBrush="{StaticResource KioskBorder}"
                         BorderThickness="1"
                         CornerRadius="12"
                         HorizontalContentAlignment="Center" />
                <TextBlock x:Name="PhoneStatus"
                           Text="{DynamicResource QabulConfirmErrorPhoneShort}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <controls:NumericKeypad x:Name="PhoneKeypad" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnPhoneBack"
                            Content="{DynamicResource ManualBackButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnPhoneContinue"
                            Content="{DynamicResource QabulContinueButton}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 4. Preview step ────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionPreview"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource ManualMurajatPreviewTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <Border Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}"
                        BorderThickness="1" CornerRadius="18" Padding="26">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource ManualMurajatTopicTitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewTopic"
                                       FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource ManualMurajatBodyTitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewBody"
                                       FontSize="22"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource ManualMurajatPhoneTitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewPhone"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PreviewStatus"
                           Text="{DynamicResource ManualMurajatSubmitError}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnPreviewEdit"
                            Content="{DynamicResource ManualEditButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnPreviewConfirm"
                            x:Name="SubmitButton"
                            Content="{DynamicResource ManualConfirmButton}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 5. Success ─────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionSuccess"
                      IsVisible="False">
            <Border Background="{StaticResource KioskCard}"
                    BorderBrush="{StaticResource KioskBorder}"
                    BorderThickness="1" CornerRadius="22" Padding="40"
                    HorizontalAlignment="Center" MaxWidth="720">
                <StackPanel Spacing="22" HorizontalAlignment="Center">
                    <!-- Big checkmark (filled circle background, white tick).
                         Mirrors SubmitSuccessOverlay's icon, scaled. -->
                    <Border Width="120" Height="120" CornerRadius="60"
                            Background="{StaticResource KioskSuccess}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="64" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource ManualMurajatSuccessTitle}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource KioskText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock x:Name="SuccessIdText"
                               FontSize="22"
                               FontFamily="Consolas, Menlo, Courier New, monospace"
                               Foreground="{StaticResource KioskTextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource ManualMurajatSuccessHint}"
                               FontSize="20"
                               Foreground="{StaticResource KioskTextMuted}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
