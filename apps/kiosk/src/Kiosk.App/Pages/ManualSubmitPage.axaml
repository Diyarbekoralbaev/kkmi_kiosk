<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Kiosk.App.State"
             xmlns:controls="using:Kiosk.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1920"
             x:Class="Kiosk.App.Pages.ManualSubmitPage"
             x:DataType="state:SessionStore">
    <!-- Touch-driven murajat flow. Phone → (lookup) → confirm OR full form →
         appeal text → preview → submit. One ScrollViewer per step, switched
         by SubmitStep. Phone uses NumericKeypad; text fields use the on-screen
         keyboard. Success shows via the shared SubmitSuccessOverlay. -->
    <Grid Background="{StaticResource KioskBg}" RowDefinitions="Auto,*"
          Margin="56,80,56,180">
        <!-- Page title + NavBar (back to home) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource ManualSubmitPageTitle}"
                       FontSize="44" FontWeight="Light"
                       Foreground="{StaticResource KioskPrimary}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="640" />
            <controls:NavBar Grid.Column="1" VerticalAlignment="Top" />
        </Grid>

        <!-- ── 1. Phone step ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionPhone"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource ManualMurajatPhoneTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <TextBlock Text="{DynamicResource MurajatPhoneHint}"
                           FontSize="18"
                           Foreground="{StaticResource KioskTextMuted}" />
                <TextBox x:Name="PhoneBox"
                         IsReadOnly="True"
                         FontFamily="Consolas, Menlo, Courier New, monospace"
                         FontSize="34"
                         FontWeight="SemiBold"
                         Padding="18,14"
                         Background="{StaticResource KioskCard}"
                         BorderBrush="{StaticResource KioskBorder}"
                         BorderThickness="1"
                         CornerRadius="12"
                         HorizontalContentAlignment="Center" />
                <TextBlock x:Name="PhoneStatus"
                           Text="{DynamicResource MurajatPhoneError}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <controls:NumericKeypad x:Name="PhoneKeypad" />
                <Button Click="OnPhoneContinue"
                        x:Name="PhoneContinueButton"
                        Content="{DynamicResource MurajatContinue}"
                        Background="{StaticResource KioskPrimary}"
                        Foreground="White"
                        FontSize="22" FontWeight="SemiBold"
                        Padding="28,18" CornerRadius="14"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── 2. Confirm identity step ───────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionConfirm"
                      IsVisible="False">
            <StackPanel Spacing="28" HorizontalAlignment="Center"
                        MaxWidth="760" Margin="0,40,0,0">
                <Border Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}"
                        BorderThickness="1" CornerRadius="18" Padding="36">
                    <TextBlock x:Name="ConfirmQuestion"
                               FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource KioskText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Button Grid.Column="0" Click="OnConfirmYes"
                            Content="{DynamicResource MurajatConfirmYes}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="24" FontWeight="SemiBold"
                            Padding="28,24" CornerRadius="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button Grid.Column="1" Click="OnConfirmNo"
                            Content="{DynamicResource MurajatConfirmNo}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="24" FontWeight="SemiBold"
                            Padding="28,24" CornerRadius="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 3. Full personal form (new / «men emas») ───────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionForm"
                      IsVisible="False">
            <StackPanel Spacing="14">
                <TextBlock Text="{DynamicResource MurajatFormTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />

                <TextBlock Text="{DynamicResource MurajatFirstName}" Classes="flabel" />
                <TextBox x:Name="FirstNameBox"
                         Text="{Binding SubmitFirstName, Mode=TwoWay}"
                         Classes="finput" MaxLength="100" />

                <TextBlock Text="{DynamicResource MurajatLastName}" Classes="flabel" />
                <TextBox x:Name="LastNameBox"
                         Text="{Binding SubmitLastName, Mode=TwoWay}"
                         Classes="finput" MaxLength="100" />

                <TextBlock Text="{DynamicResource MurajatBirthDate}" Classes="flabel" />
                <TextBox x:Name="BirthDateBox"
                         Text="{Binding SubmitBirthDate, Mode=TwoWay}"
                         Classes="finput" MaxLength="10" PlaceholderText="2000-01-31" />

                <TextBlock Text="{DynamicResource MurajatGender}" Classes="flabel" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Button Grid.Column="0" x:Name="GenderMale" Click="OnGenderMale"
                            Classes="choice"
                            Content="{DynamicResource MurajatGenderMale}" />
                    <Button Grid.Column="1" x:Name="GenderFemale" Click="OnGenderFemale"
                            Classes="choice"
                            Content="{DynamicResource MurajatGenderFemale}" />
                </Grid>

                <TextBlock Text="{DynamicResource MurajatDistrict}" Classes="flabel" />
                <Border Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}"
                        BorderThickness="1" CornerRadius="12">
                    <ScrollViewer Height="240" Padding="8">
                        <StackPanel x:Name="DistrictList" Spacing="6" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="{DynamicResource MurajatQuarter}" Classes="flabel" />
                <Border Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}"
                        BorderThickness="1" CornerRadius="12">
                    <ScrollViewer Height="240" Padding="8">
                        <StackPanel x:Name="QuarterList" Spacing="6" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="{DynamicResource MurajatAddress}" Classes="flabel" />
                <TextBox x:Name="AddressBox"
                         Text="{Binding SubmitAddress, Mode=TwoWay}"
                         Classes="finput" MaxLength="300"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />

                <controls:OnScreenKeyboard x:Name="FormKeyboard" />

                <TextBlock x:Name="FormStatus"
                           Text="{DynamicResource MurajatFormError}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnFormBack"
                            Content="{DynamicResource ManualBackButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnFormContinue"
                            Content="{DynamicResource MurajatContinue}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 4. Appeal text step ────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionText"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource MurajatTextTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <TextBlock Text="{DynamicResource MurajatTextHint}"
                           FontSize="18"
                           Foreground="{StaticResource KioskTextMuted}" />
                <TextBox x:Name="AppealTextBox"
                         Text="{Binding SubmitText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxLength="10000"
                         MinHeight="240"
                         MaxHeight="320"
                         FontSize="22"
                         Padding="18,14"
                         Background="{StaticResource KioskCard}"
                         BorderBrush="{StaticResource KioskBorder}"
                         BorderThickness="1"
                         CornerRadius="12"
                         VerticalContentAlignment="Top" />
                <TextBlock x:Name="TextStatus"
                           Text="{DynamicResource MurajatTextError}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <controls:OnScreenKeyboard x:Name="TextKeyboard" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnTextBack"
                            Content="{DynamicResource ManualBackButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnTextContinue"
                            Content="{DynamicResource MurajatContinue}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 5. Preview step ────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" x:Name="SectionPreview"
                      IsVisible="False">
            <StackPanel Spacing="18">
                <TextBlock Text="{DynamicResource ManualMurajatPreviewTitle}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskText}" />
                <Border Background="{StaticResource KioskCard}"
                        BorderBrush="{StaticResource KioskBorder}"
                        BorderThickness="1" CornerRadius="18" Padding="26">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6" x:Name="PreviewNameBlock">
                            <TextBlock Text="{DynamicResource MurajatNameLabel}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewName"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource MurajatTextLabel}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewText"
                                       FontSize="22"
                                       Foreground="{StaticResource KioskText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource ManualMurajatPhoneTitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource KioskTextMuted}" />
                            <TextBlock x:Name="PreviewPhone"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource KioskText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PreviewStatus"
                           Text="{DynamicResource ManualMurajatSubmitError}"
                           FontSize="16"
                           Foreground="{StaticResource KioskError}"
                           IsVisible="False" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Grid.Column="0" Click="OnPreviewEdit"
                            Content="{DynamicResource ManualEditButton}"
                            Background="{StaticResource KioskTileTint}"
                            Foreground="{StaticResource KioskPrimary}"
                            FontSize="20" FontWeight="SemiBold"
                            Padding="24,16" CornerRadius="14" />
                    <Button Grid.Column="1" Click="OnPreviewConfirm"
                            x:Name="SubmitButton"
                            Content="{DynamicResource ManualConfirmButton}"
                            Background="{StaticResource KioskPrimary}"
                            Foreground="White"
                            FontSize="22" FontWeight="SemiBold"
                            Padding="28,18" CornerRadius="14"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Styles>
        <Style Selector="TextBlock.flabel">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource KioskText}" />
        </Style>
        <Style Selector="TextBox.finput">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!-- Gender + location selectable items -->
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="{StaticResource KioskCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource KioskText}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="24,18" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.choice.selected">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskPrimary}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.locitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource KioskText}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.locitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KioskTileTint}" />
        </Style>
        <Style Selector="Button.locitem.selected">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.locitem.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KioskPrimary}" />
        </Style>
    </UserControl.Styles>
</UserControl>
