    <x:String x:Key="MicTestNoDevice">Mikrofon saylanbaǵan</x:String>
    <x:String x:Key="AdminSettingsSave">Saqlaw</x:String>

    <!-- ===== Enrollment window ===== -->
    <x:String x:Key="EnrollmentTitle">Kiosktı dizimge alıw</x:String>
