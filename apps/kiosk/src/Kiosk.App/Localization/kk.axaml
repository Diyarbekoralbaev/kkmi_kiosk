<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Qaraqalpaqsha (LATIN). The kiosk's default locale.

         This file used to be Cyrillic, inherited from the Joqarı Keńes kiosk.
         That produced a screen where the header, the nav buttons and the mic
         labels were Cyrillic while everything below them — page titles, group
         names, kafedra names — was Latin, because the institute's own HEMIS
         records are Latin ("Medicinalıq ximiya kafedrası", "Joqarı
         miyirbiykelik isi-233"). Two scripts on one screen read as two
         different systems, so the whole file is Latin now and the AI is
         instructed to match (see core/seed.py, the language section).

         _Locale_kk: unique sentinel for LocalizationService. -->
    <x:String x:Key="_Locale_kk">kk</x:String>

    <!-- ===== Header / footer / language labels ===== -->
    <x:String x:Key="HeaderTagline">«Aqıllı qabıllawxana» AI járdemshisi</x:String>
    <x:String x:Key="LangUz">O‘zbekcha</x:String>
    <x:String x:Key="LangRu">Русский</x:String>
    <x:String x:Key="LangKk">Qaraqalpaqsha</x:String>
    <x:String x:Key="LangEn">English</x:String>
    <x:String x:Key="HelpLabel">Járdem:</x:String>

    <!-- ===== Home page ===== -->
    <x:String x:Key="HomeGreetingChip">Xosh keldińiz!</x:String>
    <x:String x:Key="HomeQuestion">Sizge qanday járdem bere alamız?</x:String>
    <x:String x:Key="HomeSubtitle">Kerekli xızmetti saylań yaki AI járdemshi menen sóylesiń.</x:String>
    <x:String x:Key="HomeTileAiTitle">AI menen sóylesiw</x:String>
    <x:String x:Key="HomeTileAiSubtitle">Sorawlarıńızǵa jasalma intellektten tez juwap alıń</x:String>

    <!-- ===== NavBar ===== -->
    <x:String x:Key="NavBack">Artqa</x:String>
    <x:String x:Key="NavHome">Bas bet</x:String>

    <!-- ===== AI assistant page ===== -->
    <x:String x:Key="AiPageTitle">AI járdemshi</x:String>
    <x:String x:Key="AiPageStatusConnecting">Jalǵanıp atır...</x:String>
    <x:String x:Key="AiPageStatusListening">Sóyleńiz, men sizdi tıńlap atırman</x:String>
    <x:String x:Key="AiPageHint">Sorawıńızdı beriń yamasa múrájatıńızdı aytıńız. Robot sizdi tıńlap atır.</x:String>

    <!-- ===== MicOrb ===== -->
    <x:String x:Key="MicListening">Tıńlap atır</x:String>
    <x:String x:Key="MicTapToStart">Sóylew ushın basıń</x:String>
    <x:String x:Key="MicDisconnected">Jalǵanbaǵan</x:String>
    <x:String x:Key="MicConnecting">Jalǵanıp atır</x:String>
    <x:String x:Key="MicSpeaking">Sóylep atırsız</x:String>
    <x:String x:Key="MicStopping">Toqtap atır...</x:String>
    <x:String x:Key="MicStarting">Baslap atır...</x:String>
    <x:String x:Key="MicError">Qátelik</x:String>

    <!-- ===== Contacts page ===== -->
    <x:String x:Key="ContactsPageTitle">Baylanıs</x:String>
    <x:String x:Key="ContactsAddressLabel">📍 Mánzil</x:String>
    <x:String x:Key="ContactsPhoneIconLabel">☎ Telefon</x:String>
    <x:String x:Key="ContactsEmailLabel">✉ Elektron pochta</x:String>
    <x:String x:Key="ContactsHoursLabel">🕐 Jumıs waqtı</x:String>

    <!-- ===== Offline overlay ===== -->
    <x:String x:Key="OfflineTitle">Baylanıs joq</x:String>
    <x:String x:Key="OfflineHint">Baylanıs qayta tiklenbekte...</x:String>

    <!-- ===== Revoked overlay ===== -->
    <x:String x:Key="RevokedTitle">Bul kioskqa ruxsat joq</x:String>
    <x:String x:Key="RevokedBody">Bul úskeneniń kiriw kodı administrator tárepinen biykar etilgen. Sazlawshı jańa kod kiritsin.</x:String>
    <x:String x:Key="RevokedButton">Jańa kod kiritiw</x:String>

    <!-- ===== Submit success overlay (shared by voice + manual) ===== -->
    <x:String x:Key="SubmitSuccessTitle">Múrájatıńız qabıl etildi</x:String>
    <x:String x:Key="SubmitSuccessBody">Institut xızmetkerleri múrájatıńızdı kórip shıǵadı.</x:String>
    <x:String x:Key="SubmitSuccessIdLabel">Nomer:</x:String>

    <!-- ===== Updating page ===== -->
    <x:String x:Key="UpdatingTitle">Sistema jańalanıp atır</x:String>
    <x:String x:Key="UpdatingBody">Birazdan soń qayta iske túsedi. Iltimas, kútiń...</x:String>
    <x:String x:Key="UpdatingStatusPreparing">Tayarlanıp atır...</x:String>
    <x:String x:Key="UpdatingVersionLabel">Versiya: </x:String>
