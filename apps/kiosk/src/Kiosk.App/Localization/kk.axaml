    <!-- ===== Admin settings window ===== -->
    <x:String x:Key="AdminSettingsTitle">Admin sazlamaları</x:String>
    <x:String x:Key="AdminSettingsIntro">Mikrofon, dinamik hám printerdi saylań. Ózgerislerden keyin audio sessiyanı qayta baslań.</x:String>
    <x:String x:Key="AdminSettingsMicLabel">Audio kiriw (Mikrofon)</x:String>
    <x:String x:Key="AdminSettingsSpeakerLabel">Audio shıǵıs (Dinamik)</x:String>
    <x:String x:Key="AdminSettingsVolume">Dawıs deńgeyi</x:String>
