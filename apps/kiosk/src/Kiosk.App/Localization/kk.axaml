<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Қарақалпақша (Cyrillic). Default kiosk locale, per the 2026 mockup.
         _Locale_kk: unique sentinel for LocalizationService. -->
    <x:String x:Key="_Locale_kk">kk</x:String>

    <!-- ===== Header / footer / language labels ===== -->
    <x:String x:Key="HeaderTagline">«Ақыллы қабыллаўхана» AI жәрдемшиси</x:String>
    <x:String x:Key="LangUz">O‘zbekcha</x:String>
    <x:String x:Key="LangRu">Русский</x:String>
    <x:String x:Key="LangKk">Qaraqalpaqsha</x:String>
    <x:String x:Key="LangEn">English</x:String>
    <x:String x:Key="HelpLabel">Жәрдем:</x:String>

    <!-- ===== Home page (2 services: AI + Murajat) ===== -->
    <x:String x:Key="HomeGreetingChip">Хош келдиңиз!</x:String>
    <x:String x:Key="HomeQuestion">Сизге қандай жәрдем бере аламыз?</x:String>
    <x:String x:Key="HomeSubtitle">AI жәрдемши менен сөйлесиң ямаса Жоқарғы Кеңеске мүрәжат қалдырың.</x:String>
    <x:String x:Key="HomeTileAiTitle">AI менен сөйлесиў</x:String>
    <x:String x:Key="HomeTileAiSubtitle">Сораўларыңызға жасалма интеллекттен тез арада жуўап алың</x:String>

    <!-- ===== NavBar ===== -->
    <x:String x:Key="NavBack">Артқа</x:String>
    <x:String x:Key="NavHome">Бас бет</x:String>

    <!-- ===== AI Yordamchi page ===== -->
    <x:String x:Key="AiPageTitle">AI жәрдемши</x:String>
    <x:String x:Key="AiPageStatusConnecting">Жалғанып атыр...</x:String>
    <x:String x:Key="AiPageStatusListening">Сөйлеңиз, мен сизди тыңлап атырман</x:String>
    <x:String x:Key="AiPageHint">Сораўыңызды бериң ямаса мүрәжатыңызды айтыңыз. Робот сизди тыңлап атыр.</x:String>

    <!-- ===== MicOrb ===== -->
    <x:String x:Key="MicListening">Тыңлап атыр</x:String>
    <x:String x:Key="MicTapToStart">Сөйлеў ушын басың</x:String>
    <x:String x:Key="MicDisconnected">Жалғанбаған</x:String>
    <x:String x:Key="MicConnecting">Жалғанып атыр</x:String>
    <x:String x:Key="MicSpeaking">Сөйлеп атырсыз</x:String>
    <x:String x:Key="MicStopping">Тоқтап атыр...</x:String>
    <x:String x:Key="MicStarting">Баслап атыр...</x:String>
    <x:String x:Key="MicError">Қәтелик</x:String>

    <!-- ===== Submit page (AI voice preview) ===== -->

    <!-- ===== Contacts page (kept for back-compat; not on Home anymore) ===== -->
    <x:String x:Key="ContactsPageTitle">Байланыс</x:String>
    <x:String x:Key="ContactsAddressLabel">📍 Мәнзил</x:String>
    <x:String x:Key="ContactsPhoneIconLabel">☎ Телефон</x:String>
    <x:String x:Key="ContactsEmailLabel">✉ Электрон почта</x:String>
    <x:String x:Key="ContactsHoursLabel">🕐 Жумыс ўақты</x:String>

    <!-- ===== Offline overlay ===== -->
    <x:String x:Key="OfflineTitle">Байланыс жоқ</x:String>
    <x:String x:Key="OfflineHint">Байланыс қайта тикленбекте...</x:String>

    <!-- ===== Revoked overlay ===== -->
    <x:String x:Key="RevokedTitle">Бул киоскқа рухсат жоқ</x:String>
    <x:String x:Key="RevokedBody">Бул үскенениң кириў коды администратор тәрепинен бийкар етилген. Сазлаўшы жаңаланыў кодын киритсин.</x:String>
    <x:String x:Key="RevokedButton">Жаңа код киритиў</x:String>

    <!-- ===== Submit success overlay (shared by voice + manual) ===== -->
    <x:String x:Key="SubmitSuccessTitle">Мүрәжатыңыз қабыл етилди</x:String>
    <x:String x:Key="SubmitSuccessBody">Кеңес хызметкерлери сиздиң мүрәжатыңызды көрип шығады.</x:String>
    <x:String x:Key="SubmitSuccessIdLabel">Номер:</x:String>

    <!-- ===== Updating page ===== -->
    <x:String x:Key="UpdatingTitle">Система жаңаланып атыр</x:String>
    <x:String x:Key="UpdatingBody">Бираздан соң қайта иске түседи. Илтимас, күтиң...</x:String>
    <x:String x:Key="UpdatingStatusPreparing">Таярланып атыр...</x:String>
    <x:String x:Key="UpdatingVersionLabel">Версия: </x:String>
    <x:String x:Key="UpdatingDownloadingLabel">Жүкленип атыр...</x:String>
    <x:String x:Key="UpdatingMandatory">Мәжбүрий жаңаланыў...</x:String>
    <x:String x:Key="UpdatingApplying">Жаңаланыў орнатылмақта...</x:String>
    <x:String x:Key="UpdatingFailed">Жаңаланыў сәтсиз тамамланды — киоск ески версияда ислеп тур.</x:String>

    <!-- ===== Admin PIN dialog ===== -->
    <x:String x:Key="AdminPinTitle">Админ сазламалары</x:String>
    <x:String x:Key="AdminPinPrompt">PIN-кодты киритиң</x:String>
    <x:String x:Key="AdminPinIncorrect">PIN-код қәте</x:String>
    <x:String x:Key="AdminPinCancel">Бийкар етиў</x:String>
    <x:String x:Key="AdminPinConfirm">Кириў</x:String>

    <!-- ===== Admin choice dialog ===== -->
    <x:String x:Key="AdminChoiceTitle">Сайлаң</x:String>
    <x:String x:Key="AdminChoicePrompt">Программадан шығыў ямаса сазламаларды ашыў</x:String>
    <x:String x:Key="AdminExit">Шығыў</x:String>
    <x:String x:Key="AdminSettings">Сазламалар</x:String>
    <x:String x:Key="AdminCancel">Бийкар етиў</x:String>

    <!-- ===== Admin settings window ===== -->
    <x:String x:Key="AdminSettingsTitle">Админ сазламалары</x:String>
    <x:String x:Key="AdminSettingsIntro">Микрофон, динамик ҳәм принтерди сайлаң. Өзгерислерден кейин аудио сессияны қайта баслаң.</x:String>
    <x:String x:Key="AdminSettingsMicLabel">Аудио кириў (Микрофон)</x:String>
    <x:String x:Key="AdminSettingsSpeakerLabel">Аудио шығыс (Динамик)</x:String>
    <x:String x:Key="AdminSettingsVolume">Даўыс деңгейи</x:String>
    <x:String x:Key="AdminSettingsPrinter">Принтер</x:String>
    <x:String x:Key="AdminSettingsAutoPrint">Қабыл талонын автомат түрде басып шығарыў</x:String>
    <x:String x:Key="AdminSettingsTestPrint">Тест ушын басып шығарыў</x:String>
    <x:String x:Key="AdminSettingsTestMic">Микрофонды тексериў</x:String>
    <x:String x:Key="MicTestSpeakNow">Сөйлең (3 секунд)...</x:String>
    <x:String x:Key="MicTestPass">Микрофон ислеп тур</x:String>
    <x:String x:Key="MicTestSilent">Даўыс анықланбады — басқа үскенени сынап көриң</x:String>
    <x:String x:Key="MicTestErrorOpen">Үскенени ашыў имканы болмады</x:String>
    <x:String x:Key="MicTestNoDevice">Микрофон сайланбаған</x:String>
    <x:String x:Key="AdminSettingsSave">Сақлаў</x:String>

    <!-- ===== Enrollment window ===== -->
    <x:String x:Key="EnrollmentTitle">Киоскты дизимге алыў</x:String>
    <x:String x:Key="EnrollmentIntro">Биринши мәрте жалғаныў. Супер-панелдеги дизимге алыў кодын киритиң.</x:String>
    <x:String x:Key="EnrollmentBackendLabel">Сервер мәнзили</x:String>
    <x:String x:Key="EnrollmentCodeLabel">Дизимге алыў коды</x:String>
    <x:String x:Key="EnrollmentButton">Дизимнен өтиў</x:String>

