<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Русский. _Locale_ru: unique sentinel for LocalizationService. -->
    <x:String x:Key="_Locale_ru">ru</x:String>

    <!-- Header / footer / language labels -->
    <x:String x:Key="HeaderTagline">AI-ассистент «Умной приёмной»</x:String>
    <x:String x:Key="LangUz">O‘zbekcha</x:String>
    <x:String x:Key="LangRu">Русский</x:String>
    <x:String x:Key="LangKk">Qaraqalpaqsha</x:String>
    <x:String x:Key="LangEn">English</x:String>
    <x:String x:Key="HelpLabel">Помощь:</x:String>

    <!-- Home page (2 services: AI + Murajat) -->
    <x:String x:Key="HomeGreetingChip">Добро пожаловать!</x:String>
    <x:String x:Key="HomeQuestion">Чем мы можем вам помочь?</x:String>
    <x:String x:Key="HomeSubtitle">Поговорите с AI-ассистентом или оставьте обращение в Кенгаш.</x:String>
    <x:String x:Key="HomeTileAiTitle">Поговорить с AI</x:String>
    <x:String x:Key="HomeTileAiSubtitle">Получите быстрые ответы от искусственного интеллекта</x:String>

    <!-- NavBar -->
    <x:String x:Key="NavBack">Назад</x:String>
    <x:String x:Key="NavHome">Главное меню</x:String>

    <!-- AI Yordamchi page -->
    <x:String x:Key="AiPageTitle">AI ассистент</x:String>
    <x:String x:Key="AiPageStatusConnecting">Подключение...</x:String>
    <x:String x:Key="AiPageStatusListening">Говорите, я слушаю</x:String>
    <x:String x:Key="AiPageHint">Задайте вопрос или расскажите о вашем обращении. Робот вас слушает.</x:String>

    <!-- MicOrb -->
    <x:String x:Key="MicListening">Слушает</x:String>
    <x:String x:Key="MicTapToStart">Нажмите чтобы начать</x:String>
    <x:String x:Key="MicDisconnected">Не подключен</x:String>
    <x:String x:Key="MicConnecting">Подключение</x:String>
    <x:String x:Key="MicSpeaking">Говорите</x:String>
    <x:String x:Key="MicStopping">Останавливается...</x:String>
    <x:String x:Key="MicStarting">Запускается...</x:String>
    <x:String x:Key="MicError">Ошибка</x:String>

    <!-- Submit page (AI voice preview) -->

    <!-- Contacts page -->
    <x:String x:Key="ContactsPageTitle">Контакты</x:String>
    <x:String x:Key="ContactsAddressLabel">📍  Адрес</x:String>
    <x:String x:Key="ContactsPhoneIconLabel">☎  Телефон</x:String>
    <x:String x:Key="ContactsEmailLabel">✉  Эл. почта</x:String>
    <x:String x:Key="ContactsHoursLabel">🕐  Часы работы</x:String>

    <!-- Offline overlay -->
    <x:String x:Key="OfflineTitle">Нет соединения</x:String>
    <x:String x:Key="OfflineHint">Соединение восстанавливается...</x:String>

    <!-- Revoked overlay -->
    <x:String x:Key="RevokedTitle">Доступ к этому киоску запрещён</x:String>
    <x:String x:Key="RevokedBody">Доступ этого устройства отозван администратором. Оператор должен ввести новый код.</x:String>
    <x:String x:Key="RevokedButton">Ввести новый код</x:String>

    <!-- Submit success overlay (shared by voice + manual) -->
    <x:String x:Key="SubmitSuccessTitle">Ваше обращение принято</x:String>
    <x:String x:Key="SubmitSuccessBody">Сотрудники Кенгаша рассмотрят ваше обращение.</x:String>
    <x:String x:Key="SubmitSuccessIdLabel">Номер:</x:String>

    <!-- Updating page -->
    <x:String x:Key="UpdatingTitle">Система обновляется</x:String>
    <x:String x:Key="UpdatingBody">Через несколько секунд произойдёт перезагрузка. Подождите...</x:String>
    <x:String x:Key="UpdatingStatusPreparing">Подготовка...</x:String>
    <x:String x:Key="UpdatingVersionLabel">Версия: </x:String>
    <x:String x:Key="UpdatingDownloadingLabel">Загружается...</x:String>
    <x:String x:Key="UpdatingMandatory">Обязательное обновление...</x:String>
    <x:String x:Key="UpdatingApplying">Применяется...</x:String>
    <x:String x:Key="UpdatingFailed">Обновление не прошло — работает старая версия.</x:String>

    <!-- Admin PIN dialog -->
    <x:String x:Key="AdminPinTitle">Настройки администратора</x:String>
    <x:String x:Key="AdminPinPrompt">Введите PIN-код</x:String>
    <x:String x:Key="AdminPinIncorrect">PIN-код неверный</x:String>
    <x:String x:Key="AdminPinCancel">Отмена</x:String>
    <x:String x:Key="AdminPinConfirm">Войти</x:String>

    <!-- Admin choice dialog -->
    <x:String x:Key="AdminChoiceTitle">Выберите</x:String>
    <x:String x:Key="AdminChoicePrompt">Выйти из программы или открыть настройки</x:String>
    <x:String x:Key="AdminExit">Выход</x:String>
    <x:String x:Key="AdminSettings">Настройки</x:String>
    <x:String x:Key="AdminCancel">Отмена</x:String>

    <!-- Admin settings window -->
    <x:String x:Key="AdminSettingsTitle">Настройки администратора</x:String>
    <x:String x:Key="AdminSettingsIntro">Выберите микрофон, динамик и принтер. После изменений перезапустите аудио-сессию.</x:String>
    <x:String x:Key="AdminSettingsMicLabel">Аудио вход (Микрофон)</x:String>
    <x:String x:Key="AdminSettingsSpeakerLabel">Аудио выход (Динамик)</x:String>
    <x:String x:Key="AdminSettingsVolume">Громкость</x:String>
    <x:String x:Key="AdminSettingsPrinter">Принтер</x:String>
    <x:String x:Key="AdminSettingsAutoPrint">Автоматически печатать талон</x:String>
    <x:String x:Key="AdminSettingsTestPrint">Пробная печать</x:String>
    <x:String x:Key="AdminSettingsTestMic">Проверить микрофон</x:String>
    <x:String x:Key="MicTestSpeakNow">Говорите (3 секунды)...</x:String>
    <x:String x:Key="MicTestPass">Микрофон работает</x:String>
    <x:String x:Key="MicTestSilent">Звук не обнаружен — попробуйте другое устройство</x:String>
    <x:String x:Key="MicTestErrorOpen">Не удалось открыть устройство</x:String>
    <x:String x:Key="MicTestNoDevice">Микрофон не выбран</x:String>
    <x:String x:Key="AdminSettingsSave">Сохранить</x:String>

    <!-- Enrollment window -->
    <x:String x:Key="EnrollmentTitle">Регистрация киоска</x:String>
    <x:String x:Key="EnrollmentIntro">Первое подключение. Введите код регистрации из супер-панели.</x:String>
    <x:String x:Key="EnrollmentBackendLabel">Адрес сервера</x:String>
    <x:String x:Key="EnrollmentCodeLabel">Код регистрации</x:String>
    <x:String x:Key="EnrollmentButton">Зарегистрировать</x:String>

    <!-- Phone step -->

    <!-- Identity confirm step -->

    <!-- Full personal form -->

    <!-- Appeal text step -->

    <!-- Preview labels -->

    <!-- ═══ Institute screens ═══ -->
    <x:String x:Key="HomeTileLibraryTitle">ИИ-библиотека</x:String>
    <x:String x:Key="HomeTileLibrarySubtitle">Книги и учебная литература</x:String>
    <x:String x:Key="HomeTileAbituriyentTitle">ИИ-абитуриент</x:String>
    <x:String x:Key="HomeTileAbituriyentSubtitle">Направления обучения и приём</x:String>
    <x:String x:Key="HomeTileMurojatTitle">ИИ-обращение</x:String>
    <x:String x:Key="HomeTileMurojatSubtitle">Отправить обращение, жалобу или предложение</x:String>
    <x:String x:Key="HomeTileScheduleTitle">Расписание занятий</x:String>
    <x:String x:Key="HomeTileScheduleSubtitle">Расписание по группам</x:String>
    <x:String x:Key="HomeTileReceptionTitle">Приём руководства</x:String>
    <x:String x:Key="HomeTileReceptionSubtitle">Записаться на приём к ректору и проректорам</x:String>
    <x:String x:Key="LibraryPageTitle">ИИ-библиотека</x:String>
    <x:String x:Key="AbituriyentPageTitle">Направления обучения</x:String>
    <x:String x:Key="AbituriyentQuotaNote">Квоты, проходные баллы и сумма контракта ежегодно объявляются приёмной комиссией — за точной информацией обращайтесь туда.</x:String>
    <x:String x:Key="SchedulePageTitle">Расписание занятий</x:String>
    <x:String x:Key="ScheduleChooseCourse">Выберите курс</x:String>
    <x:String x:Key="ScheduleCourseWord">курс</x:String>
    <x:String x:Key="ScheduleCourseLabel">{0} курс</x:String>
    <x:String x:Key="ScheduleChooseFaculty">Выберите факультет</x:String>
    <x:String x:Key="ScheduleWhichGroup">Какая группа?</x:String>
    <x:String x:Key="ScheduleScopeToday">Сегодня</x:String>
    <x:String x:Key="ScheduleScopeTomorrow">Завтра</x:String>
    <x:String x:Key="ScheduleScopeLastWeek">Последняя неделя</x:String>
    <x:String x:Key="ScheduleScopeDate">Выбрать дату</x:String>
    <x:String x:Key="ScheduleChooseDate">Выберите дату</x:String>
    <x:String x:Key="ScheduleShowDay">Показать этот день</x:String>
    <x:String x:Key="ScheduleWholeWeek">Вся неделя</x:String>
    <x:String x:Key="ScheduleLastTaughtNote">последняя учебная неделя</x:String>
    <x:String x:Key="ScheduleFilterGroups">Введите название группы</x:String>
    <x:String x:Key="ScheduleChangeGroup">Другая группа</x:String>
    <x:String x:Key="ScheduleNoLessonsTitle">В этот день занятий нет</x:String>
    <x:String x:Key="ScheduleNoLessonsBody">Попробуйте выбрать другой день.</x:String>
    <x:String x:Key="ScheduleNoScheduleTitle">У этой группы нет расписания</x:String>
    <x:String x:Key="ScheduleNoScheduleBody">HEMIS не публикует расписание для этой группы. Выберите другую группу или обратитесь в деканат.</x:String>
    <x:String x:Key="ScheduleYearNotPublishedTitle">Расписание нового учебного года ещё не опубликовано</x:String>
    <x:String x:Key="ScheduleYearNotPublishedBody">Расписание обычно вносится в систему перед началом учебного года.</x:String>
    <x:String x:Key="ScheduleShowLastYear">Показать последнюю учебную неделю</x:String>
    <x:String x:Key="CommonCancel">Отмена</x:String>
    <x:String x:Key="AbituriyentFilter">Направление или факультет</x:String>
    <x:String x:Key="AbituriyentCount">{0} направлений</x:String>
    <x:String x:Key="AbituriyentLanguages">ЯЗЫКИ ОБУЧЕНИЯ</x:String>
    <x:String x:Key="AbituriyentGroups">групп</x:String>
    <x:String x:Key="AbituriyentSubjects">Что вы будете изучать</x:String>
    <x:String x:Key="AbituriyentBackToList">Все направления</x:String>
    <x:String x:Key="LibrarySearchPlaceholder">Название книги или автор</x:String>
    <x:String x:Key="LibrarySearchButton">Найти</x:String>
    <x:String x:Key="LibraryBrowseHint">Выберите раздел или воспользуйтесь поиском</x:String>
    <x:String x:Key="LibraryNoResultsTitle">Ничего не найдено</x:String>
    <x:String x:Key="LibraryNoResultsBody">Такой книги нет в каталоге. Обратитесь к сотрудникам читального зала.</x:String>
    <x:String x:Key="LibraryBackToSections">Разделы</x:String>
    <x:String x:Key="LibraryBackToList">Назад к списку</x:String>
    <x:String x:Key="LibraryShelf">ПОЛКА</x:String>
    <x:String x:Key="LibraryCopies">ЭКЗЕМПЛЯРОВ</x:String>
    <x:String x:Key="LibraryAbout">О КНИГЕ</x:String>
    <x:String x:Key="LibraryYear">Год издания</x:String>
    <x:String x:Key="LibraryPublisher">Издательство</x:String>
    <x:String x:Key="LibraryNotRecorded">не указано</x:String>
    <x:String x:Key="LibraryLang_kk">Каракалпакский</x:String>
    <x:String x:Key="LibraryLang_uz">Узбекский</x:String>
    <x:String x:Key="LibraryLang_ru">Русский</x:String>
    <x:String x:Key="LibraryLang_en">Английский</x:String>
    <x:String x:Key="MurojatPageTitle">Отправить обращение</x:String>
    <x:String x:Key="MurojatNamePrompt">Ваше имя и фамилия</x:String>
    <x:String x:Key="MurojatNameWatermark">Например: Алиев Алишер</x:String>
    <x:String x:Key="MurojatNameError">Введите имя и фамилию полностью</x:String>
    <x:String x:Key="MurojatPhonePrompt">Ваш номер телефона</x:String>
    <x:String x:Key="MurojatPhoneError">Номер телефона неполный (9 цифр)</x:String>
    <x:String x:Key="MurojatTextPrompt">Текст обращения</x:String>
    <x:String x:Key="MurojatTextWatermark">Что произошло и о чём вы просите — опишите подробно</x:String>
    <x:String x:Key="MurojatTextError">Введите минимум 5 символов</x:String>
    <x:String x:Key="MurojatReviewTitle">Проверьте данные</x:String>
    <x:String x:Key="MurojatNameLabel">Ф.И.О.</x:String>
    <x:String x:Key="MurojatPhoneLabel">Телефон</x:String>
    <x:String x:Key="MurojatTextLabel">Текст обращения</x:String>
    <x:String x:Key="MurojatContinue">Продолжить</x:String>
    <x:String x:Key="MurojatEdit">Изменить</x:String>
    <x:String x:Key="MurojatConfirm">Подтвердить и отправить</x:String>
    <x:String x:Key="MurojatSubmitError">Не удалось отправить. Попробуйте ещё раз.</x:String>
    <x:String x:Key="MurojatVoiceConfirmPhrase">Да, верно</x:String>
    <x:String x:Key="ReceptionPageTitle">Приём руководства</x:String>
    <x:String x:Key="ReceptionChoosePrompt">К кому вы хотите попасть?</x:String>
    <x:String x:Key="ReceptionNoOfficials">График приёма пока не внесён. Обратитесь в секретариат.</x:String>
    <x:String x:Key="ReceptionOfficialLabel">Принимает</x:String>
    <x:String x:Key="ReceptionWhenLabel">Время приёма</x:String>
    <x:String x:Key="ReceptionReasonPrompt">Причина обращения</x:String>
    <x:String x:Key="ReceptionReasonWatermark">Кратко опишите</x:String>
    <x:String x:Key="ReceptionReasonLabel">Причина</x:String>
