# ═══════════════════════════════════════════════════════════════════════════
# Kiosk Gov - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

COMPOSE_PROJECT_NAME=kiosk-gov

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED: Google Gemini Live API
# ═══════════════════════════════════════════════════════════════════════════
# Get your API key at: https://console.cloud.google.com/apis/credentials

GOOGLE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED (Production): Admin UI Auth
# ═══════════════════════════════════════════════════════════════════════════
# Generate with: openssl rand -hex 32

JWT_SECRET=

# Admin UI bind controls
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=3003

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL: Docker socket (for Admin UI container management)
# ═══════════════════════════════════════════════════════════════════════════
# DOCKER_SOCK=/var/run/docker.sock
# DOCKER_GID=999

# ═══════════════════════════════════════════════════════════════════════════
# System Configuration
# ═══════════════════════════════════════════════════════════════════════════

TZ=Asia/Tashkent

# Admin UI CORS (comma-separated origins; * for wildcard dev only)
# ADMIN_UI_CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# ═══════════════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info               # debug|info|warning|error|critical
LOG_FORMAT=console           # console (colored) | json

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL: Google Vertex AI Live API
# ═══════════════════════════════════════════════════════════════════════════
# For enterprise/production. Requires service account JSON.
# GOOGLE_CLOUD_PROJECT=my-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
