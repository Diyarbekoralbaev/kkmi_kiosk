# Backend runtime
ENV=development
LOG_LEVEL=INFO
APP_NAME=kkmi-kiosk-backend

# Postgres
DATABASE_URL=postgresql+asyncpg://kiosk:kiosk@postgres:5432/kkmi_kiosk

# JWT (generate via: openssl rand -hex 32)
JWT_SECRET=change-me-please-32-hex-bytes-minimum-or-app-will-be-insecure
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Bootstrap super admin (created on first run if no super admin exists)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-please

# Gemini Live
GOOGLE_API_KEY=

# CORS (JSON list)
# HEMIS — the institute's instance of the national higher-education system.
# Read-only; used by the nightly mirror (`python -m src.hemis_sync`).
# Token comes from the HEMIS admin panel's "API User". Backend-only.
HEMIS_API_BASE=https://student.kkmi.uz/rest
HEMIS_TOKEN=

CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Archive directory (read-only, mounted into backend for one-time YAML seed)
