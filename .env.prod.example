# Production environment template.
# Copy to .env.prod (next to docker-compose.prod.yml on the server) and fill in.
# NEVER commit the real .env.prod.

# ── Domains ─────────────────────────────────────────────────────────────
# Three independent subdomains under diyarbek.uz, all behind the host nginx.
# TLS: single multi-SAN cert at /etc/letsencrypt/live/joqari-kenes/ — see
# scripts/install-cloudflare-cert.sh. Compose doesn't issue certs.
#
#   api.kioska.dbc.uz           → backend (kiosk WS + admin/gov API)
#   gov.kioska.dbc.uz          → gov admin SPA + public booking/verify
#   super.kioska.dbc.uz   → super admin SPA (you)

# Public base URL the BACKEND uses to build verify links (QR codes).
# Must be the gov-panel domain — that's where /p/qabul/verify/<token> lives.
PUBLIC_BASE_URL=https://gov.kioska.dbc.uz

# CORS allow-list — exactly the panel hostnames, no localhost in prod.
CORS_ORIGINS=["https://super.kioska.dbc.uz","https://gov.kioska.dbc.uz"]

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=__GENERATE_64_CHAR_RANDOM__
POSTGRES_DB=joqari_kenes

# ── Backend secrets ─────────────────────────────────────────────────────
# 64-byte url-safe random — `openssl rand -base64 48`
JWT_SECRET=__GENERATE_LONG_RANDOM__

SUPER_ADMIN_EMAIL=admin@diyarbek.uz
SUPER_ADMIN_PASSWORD=__STRONG_PASSWORD__

# ── Gemini Live API key ─────────────────────────────────────────────────
# Backend-side only; never exposed to the kiosk.
GOOGLE_API_KEY=__YOUR_KEY__

# ── GitHub release sync (private repo) ─────────────────────────────────
# Fine-grained PAT with `Contents: Read` on the kiosk repo only.
# Used to:
#   - download release assets via /api/super/releases/sync-github
#   - verify webhook payloads
GITHUB_TOKEN=__ghp_or_pat_xxxxxxxxxxxxxxxxxxxx__
GITHUB_WEBHOOK_SECRET=__GENERATE_32_CHAR_RANDOM__

# Repo to sync from (owner/repo).
KIOSK_GITHUB_REPO=diyarbekoralbaev/joqari_kenes

# Auto-publish kiosk releases pulled from GitHub. Default: false (drafts only,
# super-admin reviews + clicks publish). Flip to true once CI + smoke tests
# are reliable enough to trust.
KIOSK_AUTO_PUBLISH_ON_GITHUB_SYNC=false
