# Production environment template (KKMI).
# Copy to .env.prod (next to docker-compose.prod.yml on the server) and fill in.
# NEVER commit the real .env.prod.

# ── Domains ─────────────────────────────────────────────────────────────
# TLS: single multi-SAN cert at /etc/letsencrypt/live/kkmi/ — issued by
# scripts/server-setup.sh. Compose does not issue certs; the host nginx
# terminates TLS and proxies to 127.0.0.1 ports.
#
#   kkmi-api.diyarbek.uz     → backend (kiosk WS + all APIs)   :8031
#   kkmi.diyarbek.uz         → institute admin SPA + QR verify :8033
#   kkmi-super.diyarbek.uz   → provider admin SPA (you)        :8032
#
# kkmi-api is the one hostname that must never change: kiosks store it at
# enrollment and production builds pin its certificate.

# Public base URL the BACKEND uses to build QR verification links printed on
# reception tickets. Must be the institute panel host — that is where
# /p/qabul/verify/<token> lives.
PUBLIC_BASE_URL=https://kkmi.diyarbek.uz

# CORS allow-list — exactly the panel hostnames, never localhost in prod.
# (kkmi.diyarbek.uz proxies /api/ same-origin, so strictly it needs no entry;
# it is listed so a direct cross-origin call from the panel still works.)
CORS_ORIGINS=["https://kkmi-super.diyarbek.uz","https://kkmi.diyarbek.uz"]

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=__GENERATE_64_CHAR_RANDOM__
POSTGRES_DB=kkmi_kiosk

# ── Backend secrets ─────────────────────────────────────────────────────
# `openssl rand -base64 48`
JWT_SECRET=__GENERATE_LONG_RANDOM__

SUPER_ADMIN_EMAIL=admin@diyarbek.uz
SUPER_ADMIN_PASSWORD=__STRONG_PASSWORD__

# ── Gemini Live API key ─────────────────────────────────────────────────
# Backend-side only; never exposed to the kiosk.
GOOGLE_API_KEY=__YOUR_KEY__

# ── Cloudflare Gemini relay (SHARED with the other kiosk stacks) ─────────
# The host cannot reach Google directly (DPI block on the international hop),
# so the backend forwards through a Cloudflare Worker. The same Worker serves
# every kiosk stack on this server — it is a dumb forwarder and carries no
# tenant data.
GEMINI_RELAY_URL=https://gemini-relay.diyarbekoralbaev.workers.dev
GEMINI_RELAY_TOKEN=__SAME_AS_KIOSK_GOV__

# ── Deep health endpoint token (gates /health/deep; Gatus sends it) ──────
# `openssl rand -hex 16`
HEALTH_DEEP_TOKEN=__GENERATE_32_HEX__

# ── Gatus ntfy alert topic (effectively a shared secret) ─────────────────
# Only used if the `status` compose profile is enabled; this deployment has no
# status subdomain, so the container is not started.
NTFY_TOPIC=kkmi-ops-__RANDOM_HEX__

# ── HEMIS (student.kkmi.uz) ──────────────────────────────────────────────
# Read-only. Used by the nightly mirror (`python -m src.hemis_sync`) which
# copies schedules, groups and programmes into Postgres so the kiosk never
# waits on an upstream call mid-conversation. The token is an "API User"
# bearer token from the HEMIS admin panel. Backend-only, never on a kiosk.
HEMIS_API_BASE=https://student.kkmi.uz/rest
HEMIS_TOKEN=__HEMIS_API_USER_TOKEN__

# ── GitHub release sync (kiosk binary auto-update) ───────────────────────
# Fine-grained PAT with `Contents: Read` on the kiosk repo only.
GITHUB_TOKEN=__ghp_or_pat_xxxxxxxxxxxxxxxxxxxx__
GITHUB_WEBHOOK_SECRET=__GENERATE_32_CHAR_RANDOM__
KIOSK_GITHUB_REPO=diyarbekoralbaev/kkmi_kiosk
KIOSK_AUTO_PUBLISH_ON_GITHUB_SYNC=false
