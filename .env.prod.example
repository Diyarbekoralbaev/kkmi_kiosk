# Production environment template (Joqarı Keńes).
# Copy to .env.prod (next to docker-compose.prod.yml on the server) and fill in.
# NEVER commit the real .env.prod.

# ── Domains ─────────────────────────────────────────────────────────────
# Council subdomains under the *.kioska.dbc.uz wildcard, behind the host nginx.
# TLS: single multi-SAN cert at /etc/letsencrypt/live/joqari-kenes/ — issued by
# scripts/server-setup.sh (co-location-safe). Compose doesn't issue certs.
#
#   kenes-api.kioska.dbc.uz     → backend (kiosk WS + admin/gov API)   :8011
#   kenes-gov.kioska.dbc.uz     → gov admin SPA + public verify        :8013
#   kenes-super.kioska.dbc.uz   → super admin SPA (you)                :8012
#   kenes-status.kioska.dbc.uz  → Gatus status page                    :8015

# Public base URL the BACKEND uses to build verify links (QR codes).
# Must be the gov-panel domain — that's where /p/qabul/verify/<token> lives.
PUBLIC_BASE_URL=https://kenes-gov.kioska.dbc.uz

# CORS allow-list — exactly the panel hostnames, no localhost in prod.
CORS_ORIGINS=["https://kenes-super.kioska.dbc.uz","https://kenes-gov.kioska.dbc.uz"]

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=__GENERATE_64_CHAR_RANDOM__
POSTGRES_DB=joqari_kenes

# ── Backend secrets ─────────────────────────────────────────────────────
# `openssl rand -base64 48`
JWT_SECRET=__GENERATE_LONG_RANDOM__

SUPER_ADMIN_EMAIL=admin@diyarbek.uz
SUPER_ADMIN_PASSWORD=__STRONG_PASSWORD__

# ── Gemini Live API key ─────────────────────────────────────────────────
# Backend-side only; never exposed to the kiosk.
GOOGLE_API_KEY=__YOUR_KEY__

# ── Cloudflare relays (REUSED from kiosk_gov — generic forwarders) ───────
# The Moscow host can't reach Google/Telegram directly (DPI block); the
# backend forwards through these Cloudflare Workers. Same Workers as
# kiosk_gov — they carry no tenant data. Telegram is DISABLED for the Council
# (no notifications), so only the Gemini relay is needed.
GEMINI_RELAY_URL=https://gemini-relay.diyarbekoralbaev.workers.dev
GEMINI_RELAY_TOKEN=__SAME_AS_KIOSK_GOV__

# ── Deep health endpoint token (gates /health/deep; Gatus sends it) ──────
# `openssl rand -hex 16`
HEALTH_DEEP_TOKEN=__GENERATE_32_HEX__

# ── Gatus ntfy alert topic (effectively a shared secret) ─────────────────
NTFY_TOPIC=nukus-kenes-ops-__RANDOM_HEX__

# ── GitHub release sync (kiosk binary auto-update) ───────────────────────
# Fine-grained PAT with `Contents: Read` on the kiosk repo only.
GITHUB_TOKEN=__ghp_or_pat_xxxxxxxxxxxxxxxxxxxx__
GITHUB_WEBHOOK_SECRET=__GENERATE_32_CHAR_RANDOM__
KIOSK_GITHUB_REPO=diyarbekoralbaev/joqari_kenes
KIOSK_AUTO_PUBLISH_ON_GITHUB_SYNC=false
